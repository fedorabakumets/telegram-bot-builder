# syntax=docker/dockerfile:1
# @fileoverview Отдельная сборка интерфейса и лёгкого сервера прокси без БД и Python.
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json .npmrc ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build:client

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
# Только браузерная сборка и модули стандартной библиотеки Node.js.
COPY --from=builder /app/dist ./dist
COPY frontend ./frontend
EXPOSE 5173
CMD ["node", "frontend/index.mjs"]
