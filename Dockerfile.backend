# syntax=docker/dockerfile:1
# @fileoverview Отдельная сборка API и ботов; действующий совмещённый образ не изменяется.
FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json .npmrc ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build:server

FROM node:24-alpine
RUN apk add --no-cache python3 py3-pip procps postgresql18-client
WORKDIR /app
ENV NODE_ENV=production APP_MODE=backend
COPY requirements.txt ./
RUN pip3 install --break-system-packages -r requirements.txt
COPY package*.json .npmrc ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --from=builder /app/dist/server ./dist/server
# Исходные шаблоны, SQL и Python нужны генерации, экспорту и исполнению ботов.
COPY server ./server
COPY lib ./lib
COPY shared ./shared
# Общие функции исторически импортируются генератором из client/.
COPY client/utils ./client/utils
COPY client/components/editor/sidebar/parsePythonCodeToJson.ts ./client/components/editor/sidebar/parsePythonCodeToJson.ts
COPY scripts ./scripts
COPY tsconfig*.json ./
COPY drizzle.config.ts* ./
COPY migrations ./migrations
COPY version.json ./version.json
COPY assets ./assets
EXPOSE 5000
CMD ["node", "dist/server/index.js"]
