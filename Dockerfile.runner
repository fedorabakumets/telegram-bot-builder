# syntax=docker/dockerfile:1
# @fileoverview Образ исполнителя ботов и очереди рассылок с отдельной сборкой JavaScript.
# Образ исполнителя ботов (`WORKER_RUNTIME=remote`): исполнитель, worker.py
# и Python-зависимости ботов, без панели и клиента. Подробно: docs/deployment/BOT_RUNNER.md
# Собирается BuildKit (`docker buildx build`): кеш npm/pip между сборками, amd64 и arm64.

# ── Сборка исполнителя в один JS-файл ────────────────────────────────────────
# Бандл не зависит от архитектуры, поэтому собирается на платформе сборщика
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS builder

WORKDIR /app
COPY package*.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund
COPY server ./server
COPY shared ./shared
COPY tsconfig*.json ./
RUN npx esbuild server/runner/index.ts --bundle --platform=node --target=node24 \
    --format=cjs --tsconfig=tsconfig.node.json --log-level=error --outfile=dist-runner/runner.cjs

# ── Исполнитель ──────────────────────────────────────────────────────────────
FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends libstdc++6 \
 && rm -rf /var/lib/apt/lists/*
# node берётся из образа целевой архитектуры, а не из сборщика
COPY --from=node:24-bookworm-slim /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt

COPY server/python ./python
COPY --from=builder /app/dist-runner/runner.cjs ./runner.cjs

ENV RUNNER_WORKER_SCRIPT=/app/python/worker.py \
    RUNNER_PYTHON=python3 \
    RUNNER_CACHE_DIR=/app/cache \
    PYTHONUNBUFFERED=1

# Нужны только REDIS_URL и RUNNER_ID
CMD ["node", "/app/runner.cjs"]
