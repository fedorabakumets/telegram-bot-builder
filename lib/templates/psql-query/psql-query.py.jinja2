{#
  Шаблон узла psql_query — прямой SQL-запрос к PostgreSQL.

  {имя} в запросе — параметр asyncpg ($1, $2), не вклейка текста.
  '{имя}' (одинарные кавычки вплотную) тоже параметр, кавычки снимаются.
  Перед запросом, внутри транзакции соединения, ставится statement_timeout 15 с.
  Шаблон resultFormat text не трогается: это текст сообщения.

  @param {string} nodeId          — ID узла
  @param {string} query           — SQL-запрос с {параметрами}
  @param {string} saveResultTo    — переменная для сохранения результата
  @param {string} resultFormat    — json | text | first_row | affected
  @param {string} textTemplate    — шаблон строки для формата text
  @param {string} autoTransitionTo — ID следующего узла
  @param {string} connectionSource — builtin | env | custom
  @param {string} connectionEnvVar — имя переменной окружения (при env)
  @param {string} connectionString — прямой URL подключения (при custom)
  @param {boolean} builtinEnabled  — разрешён ли режим builtin (PSQL_BUILTIN_ENABLED на сервере)
#}
{%- set safe_node_id = nodeId | safe_name -%}
{%- set builtin_blocked = connectionSource == 'builtin' and not builtinEnabled -%}
{%- set bound = query | psql_bind -%}
{% include 'psql-query/psql-query-param.py.jinja2' %}

@dp.callback_query(lambda c: c.data == "{{ nodeId }}")
async def handle_callback_{{ safe_node_id }}(callback_query: types.CallbackQuery, state: FSMContext = None):
    """Узел psql_query: выполняет SQL-запрос к базе данных."""
    try:
        user_id = callback_query.from_user.id
        {% if builtin_blocked %}
        logging.error(f"⛔ psql_query [{{ nodeId }}]: подключение к БД платформы отключено администратором — укажите своё подключение в настройках узла")
        return
        {% else %}
        logging.info(f"🗄️ psql_query [{{ nodeId }}]: начало выполнения для пользователя {user_id}")
        if user_id not in user_data:
            user_data[user_id] = {}
        {% if connectionSource == 'builtin' %}
        if db_pool is None:
            logging.warning(f"⚠️ psql_query [{{ nodeId }}]: db_pool недоступен, пропускаем")
            return
        {% endif %}
        _all_vars = await init_all_user_vars(user_id)
        _query = {{ bound.sql | tojson }}
        {% if bound.names.length %}
        _args = [{% for pname in bound.names %}_psql_param({{ pname | tojson }}, _all_vars), {% endfor %}]
        {% endif %}
        logging.info(f"🗄️ psql_query [{{ nodeId }}]: выполняем запрос для {user_id}")
        {% if connectionSource == 'env' or connectionSource == 'custom' %}
        import asyncpg
        {% if connectionSource == 'env' %}
        _dsn, _dsn_kwargs = _psql_safe_dsn(os.environ.get({{ connectionEnvVar | tojson }}, ""))
        {% else %}
        _dsn, _dsn_kwargs = _psql_safe_dsn({{ connectionString | tojson }})
        {% endif %}
        if _dsn is None:
            logging.error(f"⛔ psql_query [{{ nodeId }}]: не задано подключение — нужен адрес вида postgresql://user:pass@host:5432/db")
            return
        _custom_pool = await asyncpg.create_pool(_dsn, min_size=1, max_size=3, **_dsn_kwargs)
        async with _custom_pool.acquire() as _conn:
        {% else %}
        async with db_pool.acquire() as _conn:
        {% endif %}
            async with _conn.transaction():
                await _conn.execute("SET LOCAL statement_timeout = '15s'")
                {% if resultFormat == 'affected' %}
                _result = await _conn.execute(_query{{ ", *_args" if bound.names.length else "" }})
                {% elif resultFormat == 'first_row' %}
                _row = await _conn.fetchrow(_query{{ ", *_args" if bound.names.length else "" }})
                _result = dict(_row) if _row else {}
                {% else %}
                _rows = await _conn.fetch(_query{{ ", *_args" if bound.names.length else "" }})
                _result = [dict(r) for r in _rows]
                {% endif %}
        {% if connectionSource == 'env' or connectionSource == 'custom' %}
        await _custom_pool.close()
        {% endif %}
        {% if saveResultTo %}
        {% if resultFormat == 'text' %}
        _lines = []
        for _r in (_result if isinstance(_result, list) else []):
            _line = replace_variables_in_text({{ textTemplate | tojson }}, _r)
            _lines.append(_line)
        user_data[user_id]["{{ saveResultTo }}"] = "\n".join(_lines)
        {% else %}
        # Нормализуем datetime → isoformat() для JSON-сериализации
        def _norm_val(v):
            return v.isoformat() if hasattr(v, 'isoformat') else v
        def _norm_row(r):
            return {k: _norm_val(v) for k, v in r.items()} if isinstance(r, dict) else r
        if isinstance(_result, list):
            _result = [_norm_row(r) for r in _result]
        elif isinstance(_result, dict):
            _result = _norm_row(_result)
        user_data[user_id]["{{ saveResultTo }}"] = _result
        {% endif %}
        await set_user_var(user_id, "{{ saveResultTo }}", user_data[user_id]["{{ saveResultTo }}"])
        logging.info(f"📦 psql_query [{{ nodeId }}]: результат сохранён в «{{ saveResultTo }}» для {user_id}")
        {% endif %}
        logging.info(f"✅ psql_query [{{ nodeId }}]: выполнено для {user_id}")
        {% if autoTransitionTo %}
        {%- set safe_target = autoTransitionTo | safe_name %}
        logging.info(f"⚡ psql_query [{{ nodeId }}]: автопереход → {{ autoTransitionTo }} для {user_id}")
        class FakeCallback:
            def __init__(self, data, user, msg):
                self.data = data
                self.from_user = user
                self.message = msg
                self._is_fake = True
            async def answer(self, *a, **kw):
                pass
        fake_cb = FakeCallback("{{ autoTransitionTo }}", callback_query.from_user, callback_query.message)
        await handle_callback_{{ safe_target }}(fake_cb, state=state)
        {% endif %}
        {% endif %}
    except Exception as e:
        logging.error(f"❌ Ошибка в psql_query [{{ nodeId }}]: {e}")
