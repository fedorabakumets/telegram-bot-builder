{% if menuCommands and menuCommands | length > 0 %}
async def set_bot_commands():
    """Настройка меню команд для BotFather. Ошибка не должна ронять старт бота."""
    from aiogram.exceptions import TelegramRetryAfter
    commands = [
{% for cmd in menuCommands %}
        BotCommand(command="{{ cmd.command }}", description="{{ cmd.description }}"),
{% endfor %}
    ]
    for _attempt in range(1, 4):
        try:
            await bot.set_my_commands(commands)
            return
        except TelegramRetryAfter as _err:
            _wait = getattr(_err, "retry_after", 5) + 1
            logging.warning(
                f"Flood на SetMyCommands: ждём {_wait}с (попытка {_attempt}/3)"
            )
            await asyncio.sleep(_wait)
        except Exception as _err:
            logging.warning(f"Меню команд не обновлено: {_err}")
            return
    logging.warning(
        "Меню команд не обновлено: лимит Telegram, бот продолжает работу"
    )

{% endif %}

# Event остановки: worker pool вызывает request_bot_stop() (signal в воркере заглушен)
_bot_stop_event = None


def request_bot_stop():
    """Graceful stop от worker pool — ставит _stop_event без cancel задачи."""
    global _bot_stop_event
    if _bot_stop_event is not None:
        _bot_stop_event.set()

{% if trackUserBlocks %}
@dp.my_chat_member()
@_analytics_guard_system
async def track_private_bot_membership(update):
    """Сохраняет блокировку или разблокировку бота пользователем в личном чате."""
    if update.chat.type != "private":
        return
    _new_status = getattr(update.new_chat_member.status, "value", update.new_chat_member.status)
    if _new_status not in {"kicked", "member"}:
        return
    _user_id = int(update.chat.id)
    _blocked = _new_status == "kicked"
    _event_text = "Пользователь заблокировал бота" if _blocked else "Пользователь разблокировал бота"
    _fact = _analytics_event('system', f'membership:{update.chat.id}:{int(update.date.timestamp())}:{_new_status}',
        update.chat.id, update.chat, update.date)
    _fact['metadata'] = {'system_kind': "bot_blocked" if _blocked else "bot_unblocked"}
    _analytics_spool_store(_fact)
    async with db_pool.acquire() as _conn:
        async with _conn.transaction():
            _outcome = await _analytics_write_event(_conn, _fact)
            if _outcome and not _outcome.get('inserted'):
                return
            _old_value = await _conn.fetchval(
                "SELECT is_blocked FROM bot_users WHERE project_id=$1 AND token_id=$2 AND user_id=$3",
                PROJECT_ID, TOKEN_ID, _user_id,
            )
            await _conn.execute(
                "UPDATE bot_users SET is_blocked=$4, last_interaction=NOW() WHERE project_id=$1 AND token_id=$2 AND user_id=$3",
                PROJECT_ID, TOKEN_ID, _user_id, 1 if _blocked else 0,
            )
            await _conn.execute("""
                INSERT INTO chat_access (project_id, token_id, chat_id, status, checked_at)
                VALUES ($1, $2, $3, $4, NOW())
                ON CONFLICT (project_id, token_id, chat_id) DO UPDATE
                SET status=EXCLUDED.status, checked_at=EXCLUDED.checked_at
            """, PROJECT_ID, TOKEN_ID, str(_user_id), "kicked" if _blocked else "available")
            if _old_value is not None and bool(_old_value) == _blocked:
                return
            _row = await _conn.fetchrow("""
                INSERT INTO bot_messages
                  (project_id, token_id, user_id, message_type, message_text, message_data, chat_type, created_at)
                VALUES ($1, $2, $3, 'system', $4, $5::jsonb, 'private', NOW())
                RETURNING id, created_at
            """, PROJECT_ID, TOKEN_ID, str(_user_id), _event_text,
                 json.dumps({"event": "bot_blocked" if _blocked else "bot_unblocked"}))
    if _redis_client:
        await _redis_client.publish(f"bot:message:{PROJECT_ID}:{TOKEN_ID}", json.dumps({
            "id": _row["id"], "userId": str(_user_id), "messageType": "system",
            "messageText": _event_text, "messageData": {"event": "bot_blocked" if _blocked else "bot_unblocked"},
            "chatId": None, "chatType": "private", "createdAt": _row["created_at"].isoformat(),
        }, ensure_ascii=False))

{% endif %}
{% if trackGroupMembership %}
@dp.my_chat_member()
@_analytics_guard_system
async def track_group_bot_membership(update):
    """Сохраняет добавление или исключение бота в группе."""
    if update.chat.type not in {"group", "supergroup"}:
        return
    _new_status = getattr(update.new_chat_member.status, "value", update.new_chat_member.status)
    if _new_status in {"member", "administrator", "creator"}:
        _access, _event, _text = "available", "bot_added_to_group", "Бота добавили в группу"
    elif _new_status in {"left", "kicked"}:
        _access, _event, _text = "kicked", "bot_removed_from_group", "Бота исключили из группы"
    else:
        return
    _chat_id = str(update.chat.id)
    _title = update.chat.title or _chat_id
    _fact = _analytics_event('system', f'membership:{update.chat.id}:{int(update.date.timestamp())}:{_new_status}',
        None, update.chat, update.date)
    _fact['metadata'] = {'system_kind': _event}
    _analytics_spool_store(_fact)
    async with db_pool.acquire() as _conn:
        async with _conn.transaction():
            _outcome = await _analytics_write_event(_conn, _fact)
            if _outcome and not _outcome.get('inserted'):
                return
            _old = await _conn.fetchval(
                "SELECT status FROM chat_access WHERE project_id=$1 AND token_id=$2 AND chat_id=$3",
                PROJECT_ID, TOKEN_ID, _chat_id,
            )
            await _conn.execute("""
                INSERT INTO chat_access (project_id, token_id, chat_id, status, checked_at)
                VALUES ($1, $2, $3, $4, NOW())
                ON CONFLICT (project_id, token_id, chat_id) DO UPDATE
                SET status=EXCLUDED.status, checked_at=EXCLUDED.checked_at
            """, PROJECT_ID, TOKEN_ID, _chat_id, _access)
            await _conn.execute("""
                INSERT INTO bot_groups (project_id, token_id, group_id, name, url, chat_type, is_active, created_at, updated_at)
                VALUES ($1, $2, $3, $4, '', $5, 1, NOW(), NOW())
                ON CONFLICT (project_id, token_id, group_id) WHERE group_id IS NOT NULL AND token_id IS NOT NULL
                DO UPDATE SET name=EXCLUDED.name, chat_type=EXCLUDED.chat_type, updated_at=NOW()
            """, PROJECT_ID, TOKEN_ID, _chat_id, _title, update.chat.type)
            if _old == _access:
                return
            _row = await _conn.fetchrow("""
                INSERT INTO bot_messages
                  (project_id, token_id, user_id, message_type, message_text, message_data, chat_type, chat_id, created_at)
                VALUES ($1, $2, $3, 'system', $4, $5::jsonb, $6, $3, NOW())
                RETURNING id, created_at
            """, PROJECT_ID, TOKEN_ID, _chat_id, _text, json.dumps({"event": _event}), update.chat.type)
    if _redis_client and _row:
        await _redis_client.publish(f"bot:message:{PROJECT_ID}:{TOKEN_ID}", json.dumps({
            "id": _row["id"], "userId": _chat_id, "messageType": "system",
            "messageText": _text, "messageData": {"event": _event},
            "chatId": _chat_id, "chatType": update.chat.type, "createdAt": _row["created_at"].isoformat(),
        }, ensure_ascii=False))

{% endif %}

# Протокол внешнего приёмника не меняет формат сценария и выбирается воркером.
_WORKER_READY_PROTOCOL = True
_WORKER_EXTERNAL_UPDATES_PROTOCOL = True
# Протокол состояния сохраняет user_data; произвольные глобальные объекты не поддерживаются.
_WORKER_EXTERNAL_STATE_PROTOCOL = 1
# Прямой polling принимает сохранённое состояние до публикации готовности.
_WORKER_DIRECT_PREPARE_PROTOCOL = 1
_WORKER_DIRECT_STATE_PROTOCOL = 1
_WORKER_EXTERNAL_UPDATES_SAFE = {{ 'False' if hasScheduleTrigger or hasApiTrigger or hasUserbotNodes or hasBackgroundTimers else 'True' }}

async def main():
    """Главная функция запуска бота"""
    global db_pool, dp, _redis_client, _redis_connected, _bot_stop_event
    {%- if userDatabaseEnabled %}
    _analytics_install_log_filter()
    {%- endif %}

    _stop_event = asyncio.Event()
    _bot_stop_event = _stop_event
    _external_updates = globals().get('_worker_external_updates')
    # Приём webhook в Node остаётся доступным, пока Python-обработчик спит.
    _node_webhook = globals().get('_worker_webhook_ingress') == 'node'
    _external_mode = callable(_external_updates) and (not WEBHOOK_URL or _node_webhook)
    _external_started = False
    _direct_state_committed = False
    if _external_mode and not _WORKER_EXTERNAL_UPDATES_SAFE:
        raise RuntimeError("Сценарий требует постоянного обработчика: сон запрещён")
    _lock_acquired = False
    _background_tasks: list = []  # Все фоновые задачи для корректной отмены при остановке
    _webhook_runner = None  # aiohttp runner для корректного завершения webhook-сервера
    _polling_task = None  # Задача dp.start_polling для stop_polling при CancelledError

    def signal_handler(signum, _frame):
        print(f"⚠️ Получен сигнал {signum}, начинаем корректное завершение...")
        _stop_event.set()

    signal.signal(signal.SIGTERM, signal_handler)
    signal.signal(signal.SIGINT, signal_handler)

    try:
        # Инициализация Redis клиента (если REDIS_URL задан)
        _redis_connected = await init_redis_client()
        if _external_mode and (not _redis_connected or _redis_client is None):
            raise RuntimeError("Внешний приёмник требует Redis для состояния обработчика")
        
        # Если Redis успешно подключился — переключаем storage у уже созданного Dispatcher
        if _redis_connected and _redis_client is not None:
            dp.fsm.storage = RedisStorage(_redis_client, TOKEN_ID)
            logging.info("🔴 FSM хранилище: Redis")
        else:
            logging.info("🐘 FSM хранилище: PostgreSQL")

        # Distributed lock через Redis — защита от двойного запуска (только в polling режиме)
        # В webhook режиме двойной запуск невозможен — Telegram шлёт апдейты на один URL
        if not WEBHOOK_URL and not _external_mode and _redis_connected and _redis_client is not None:
            import uuid
            import time as _lock_time
            _lock_key = f"bot:lock:{BOT_TOKEN[-10:]}"
            _lock_owner = uuid.uuid4().hex
            _lock_deadline = _lock_time.monotonic() + 50
            _lock_acquired = await _redis_client.set(_lock_key, _lock_owner, nx=True, ex=60)
            if not _lock_acquired:
                logging.warning(
                    f"⚠️ Бот уже запущен (Redis lock занят, TOKEN_ID={TOKEN_ID}). Завершаем дублирующий процесс."
                )
                return
            if _lock_time.monotonic() >= _lock_deadline:
                logging.error("Получение Redis lock заняло слишком много времени — запуск отменён")
                return
            logging.info("🔒 Redis lock получен — бот запускается")

            # Фоновая задача: обновляем lock каждые 30 секунд пока бот работает
            async def _refresh_lock():
                """Продлевает блокировку и останавливает бот до истечения подтверждённого срока."""
                _deadline = _lock_deadline
                _delay = 30
                while True:
                    await asyncio.sleep(min(_delay, max(0, _deadline - _lock_time.monotonic())))
                    _remaining = _deadline - _lock_time.monotonic()
                    if _remaining <= 0:
                        logging.error("Redis lock не подтверждён вовремя — останавливаем бота")
                        _stop_event.set()
                        return
                    try:
                        _attempt_started = _lock_time.monotonic()
                        _renewed = await asyncio.wait_for(
                            _redis_client.eval(
                                "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('expire', KEYS[1], 60) else return 0 end",
                                1, _lock_key, _lock_owner,
                            ),
                            timeout=min(5, _remaining),
                        )
                        if not _renewed:
                            logging.error("Redis lock потерян — останавливаем бота")
                            _stop_event.set()
                            return
                        _deadline = _attempt_started + 50
                        _delay = 30
                    except Exception:
                        _delay = 5

            _background_tasks.append(asyncio.create_task(_refresh_lock()))

        # Перенос состояния выполняется после блокировки, до первых обновлений.
        if not WEBHOOK_URL and not _external_mode and callable(globals().get('_worker_direct_prepare')):
            await _worker_direct_prepare(bool(_lock_acquired))

        # Логический запуск спящего бота подтверждает приёмник, а не каждое пробуждение.
        if not _external_mode and _redis_connected and _redis_client is not None:
            try:
                import json as _json
                await _redis_client.publish(
                    f"bot:started:{PROJECT_ID}:{TOKEN_ID}",
                    _json.dumps({"projectId": PROJECT_ID, "tokenId": TOKEN_ID, "timestamp": __import__('datetime').datetime.now().isoformat()})
                )
            except Exception:
                pass

        {%- if userDatabaseEnabled %}
        await init_database()
        # Очередь восстанавливается с диска после каждого запуска, включая смену сборки.
        _background_tasks.append(asyncio.create_task(_analytics_spool_worker()))
        {%- endif %}

        # Загружаем кэш Telegram file_id из media_file_tokens только для текущего TOKEN_ID
        if db_pool:
            await _load_media_file_id_cache()

{%- if projectId and contentCache %}
        # Загрузка контента из таблицы _content
        if db_pool:
            await load_content(db_pool)
{%- endif %}

        {%- if menuCommands and menuCommands | length > 0 %}
        await set_bot_commands()
        {%- endif %}

        {# Фильтр устаревших апдейтов — регистрируем первым чтобы отсеивать до всей логики #}
        # Подтверждённые внешней очередью сообщения не теряем из-за времени ожидания.
        if not _external_mode:
            dp.message.middleware(stale_update_filter_middleware)

        {%- if userDatabaseEnabled %}
        dp.message.middleware(message_logging_middleware)
        dp.message.outer_middleware(_analytics_observe_message)
        bot.session.middleware(_analytics_outgoing_request)
        dp.message.outer_middleware(BotOutgoingLoggingMiddleware())
        _wrap_bot_send_message(bot)
        _wrap_bot_send_photo(bot)
        _wrap_bot_send_video(bot)
        _wrap_bot_send_audio(bot)
        _wrap_bot_send_document(bot)
        _wrap_message_answer(bot)
        _wrap_bot_send_sticker(bot)
        _wrap_bot_send_voice(bot)
        _wrap_bot_send_animation(bot)
        _wrap_bot_send_media_group(bot)
        dp.callback_query.outer_middleware(callback_query_logging_middleware)
        {%- endif %}

        {%- if autoRegisterUsers %}
        dp.message.middleware(register_user_middleware)
        {%- endif %}

        {%- if incomingMessageTriggerMiddlewares and incomingMessageTriggerMiddlewares | length > 0 %}
        {%- for mw in incomingMessageTriggerMiddlewares %}
        dp.message.middleware({{ mw }})
        {%- endfor %}
        {%- endif %}

        {%- if managedBotUpdatedTriggerMiddlewares and managedBotUpdatedTriggerMiddlewares | length > 0 %}
        {%- for mw in managedBotUpdatedTriggerMiddlewares %}
        dp.message.middleware({{ mw }})
        {%- endfor %}
        {%- endif %}

        # Запускаем фоновую задачу TTL-очистки user_data
        _background_tasks.append(asyncio.create_task(cleanup_user_data()))

{%- if hasUserbotNodes %}
        # Подключаем Telethon userbot клиент
        if userbot_client:
            await userbot_client.connect()
            if not await userbot_client.is_user_authorized():
                logging.error("❌ Userbot не авторизован — проверьте USERBOT_SESSION_STRING")
            else:
                logging.info("🟣 Telethon userbot подключён")
{%- endif %}

{%- if projectId and contentCache %}
        # Фоновая перезагрузка контента из _content каждые 60 сек (fallback)
        if db_pool:
            _background_tasks.append(asyncio.create_task(_content_reload_loop(db_pool)))
        # Мгновенное обновление контента через Redis pub/sub
        if _redis_connected:
            _background_tasks.append(asyncio.create_task(_content_subscribe_redis()))
{%- endif %}

        # Проверяем доступ Telegram до подтверждения запуска воркеру.
        await bot.get_me()
        if _stop_event.is_set():
            raise RuntimeError("Запуск прерван до готовности бота")

        async def _notify_worker_ready(**_kwargs):
            """Подтверждает запуск и передачу состояния только после успешного старта."""
            nonlocal _direct_state_committed
            if _stop_event.is_set():
                raise RuntimeError("Запуск прерван до готовности бота")
            # Снимок удаляется один раз после готовности, не при неудачном запуске.
            if not WEBHOOK_URL and not _external_mode and not _direct_state_committed:
                if callable(globals().get('_worker_direct_commit')):
                    await _worker_direct_commit()
                _direct_state_committed = True
            if callable(globals().get('_worker_bot_ready')):
                _worker_bot_ready()

        # Выбор режима запуска: webhook или polling
        if WEBHOOK_URL and not _external_mode:
            # Webhook режим — запускаем aiohttp сервер
            from aiohttp import web
            from aiogram.webhook.aiohttp_server import SimpleRequestHandler, setup_application

            webhook_path = f"/api/webhook/{PROJECT_ID}/{TOKEN_ID}"
            full_webhook_url = f"{WEBHOOK_URL.rstrip('/')}{webhook_path}"

            logging.info(f"🌐 Webhook режим: {full_webhook_url}")
            logging.info(f"🔌 Порт aiohttp: {WEBHOOK_PORT}")

            await bot.set_webhook(full_webhook_url, allowed_updates=dp.resolve_used_update_types(), secret_token=WEBHOOK_SECRET_TOKEN)

            app = web.Application()
            SimpleRequestHandler(dispatcher=dp, bot=bot, secret_token=WEBHOOK_SECRET_TOKEN, handle_in_background=False).register(app, path="/webhook")
            setup_application(app, dp, bot=bot)
{%- if hasApiTrigger %}
            register_api_trigger_routes(app)
{%- endif %}

            runner = web.AppRunner(app)
            await runner.setup()
            site = web.TCPSite(runner, host="0.0.0.0", port=WEBHOOK_PORT)
            await site.start()
            _webhook_runner = runner

            logging.info(f"✅ Webhook сервер запущен на порту {WEBHOOK_PORT}")
            await _notify_worker_ready()
            await _stop_event.wait()

            await runner.cleanup()
            _webhook_runner = None
            await bot.delete_webhook()
        elif _external_mode:
            # Внешний приёмник владеет polling/webhook и блокировкой; здесь только обработка.
            _external_started = True
            await dp.emit_startup(bot=bot, **{"dispatcher": dp, "bots": (bot,), **dp.workflow_data})
            await _notify_worker_ready()
            await _external_updates(dp, bot, _stop_event)
        else:
            # Polling режим — с backoff при Telegram Conflict (два getUpdates)
            logging.info("🔄 Polling режим")
{%- if hasApiTrigger %}
            from aiohttp import web
            _api_app = web.Application()
            register_api_trigger_routes(_api_app)
            _api_runner = web.AppRunner(_api_app)
            await _api_runner.setup()
            _api_site = web.TCPSite(_api_runner, host="0.0.0.0", port=WEBHOOK_PORT)
            await _api_site.start()
            _webhook_runner = _api_runner
            logging.info(f"✅ API сервер запущен на порту {WEBHOOK_PORT}")
{%- endif %}
            _conflict_attempt = 0
            _max_conflict_retries = 6
            # Startup вызывается aiogram после подготовки диспетчера, до получения обновлений.
            dp.startup.register(_notify_worker_ready)
            while _conflict_attempt < _max_conflict_retries:
                try:
                    _polling_task = asyncio.create_task(dp.start_polling(bot, allowed_updates=dp.resolve_used_update_types()))
                    _background_tasks.append(_polling_task)
                    _stop_wait = asyncio.create_task(_stop_event.wait())
                    try:
                        _done, _ = await asyncio.wait(
                            {_polling_task, _stop_wait}, return_when=asyncio.FIRST_COMPLETED
                        )
                        if _polling_task in _done:
                            await _polling_task
                            if not _stop_event.is_set():
                                raise RuntimeError("Polling неожиданно завершился")
                        else:
                            await dp.stop_polling()
                    finally:
                        _stop_wait.cancel()
                        await asyncio.gather(_stop_wait, return_exceptions=True)
                    try:
                        await _polling_task
                    except Exception:
                        pass
                    break
                except asyncio.CancelledError:
                    raise
                except Exception as _poll_err:
                    _err_text = f"{type(_poll_err).__name__}: {_poll_err}"
                    if "Conflict" not in _err_text and "terminated by other getUpdates" not in _err_text:
                        raise
                    _conflict_attempt += 1
                    logging.warning(
                        f"⚠️ Telegram Conflict (попытка {_conflict_attempt}/{_max_conflict_retries}), ждём 10с..."
                    )
                    if _stop_event.is_set():
                        break
                    await asyncio.sleep(10)
            else:
                logging.error("❌ Polling остановлен: исчерпаны попытки после Telegram Conflict")
    except KeyboardInterrupt:
        print("⚠️ Получен сигнал остановки, завершаем работу...")
    except SystemExit:
        print("⚠️ Системное завершение, завершаем работу...")
    except asyncio.CancelledError:
        print("⚠️ Бот остановлен воркером (CancelledError)")
        # Пытаемся закрыть getUpdates до проброса cancel (иначе Conflict у нового инстанса)
        try:
            await dp.stop_polling()
        except Exception:
            pass
        if _polling_task is not None and not _polling_task.done():
            try:
                await asyncio.wait_for(asyncio.shield(_polling_task), timeout=3.0)
            except Exception:
                pass
        # Пробрасываем cancel воркеру: иначе _run_bot видит нормальный выход и
        # эмитит bot_exited:{id}:running вместо stopped
        raise
    except Exception as e:
        logging.error(f"Ошибка: {e}")
        raise
    finally:
        _bot_stop_event = None
        # Отменяем все фоновые задачи перед закрытием ресурсов
        for _task in _background_tasks:
            if not _task.done():
                _task.cancel()
        if _background_tasks:
            try:
                await asyncio.gather(*_background_tasks, return_exceptions=True)
            except Exception:
                pass
        _background_tasks.clear()

        # Останавливаем webhook-сервер если он был запущен (освобождаем порт)
        if _webhook_runner:
            try:
                await _webhook_runner.cleanup()
            except Exception:
                pass
        {%- if hasScheduleTrigger %}
        # Останавливаем фоновые schedule-задачи
        try:
            await _cancel_schedule_tasks()
        except Exception:
            pass
        {%- endif %}

        {%- if userDatabaseEnabled %}
        await _analytics_drain_pending()
        if db_pool:
            await db_pool.close()
        {%- endif %}

        # Освобождаем Redis lock при завершении (только в polling режиме — в webhook lock не устанавливался)
        if not WEBHOOK_URL and _redis_connected and _redis_client is not None and _lock_acquired:
            try:
                _released = await _redis_client.eval(
                    "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('del', KEYS[1]) else return 0 end",
                    1, _lock_key, _lock_owner,
                )
                if _released:
                    logging.info("🔓 Redis lock освобождён")
            except Exception:
                pass

        # Сон обработчика не является остановкой зарегистрированного бота.
        if not _external_mode and _redis_connected and _redis_client is not None:
            try:
                import json as _json
                await _redis_client.publish(
                    f"bot:stopped:{PROJECT_ID}:{TOKEN_ID}",
                    _json.dumps({"projectId": PROJECT_ID, "tokenId": TOKEN_ID, "timestamp": __import__('datetime').datetime.now().isoformat()})
                )
            except Exception:
                pass

        # Завершаем жизненный цикл диспетчера после сохранения аналитики и закрываем Redis.
        try:
            if _external_started:
                try:
                    await dp.emit_shutdown(bot=bot, **{"dispatcher": dp, "bots": (bot,), **dp.workflow_data})
                finally:
                    if _redis_client is not None:
                        await _redis_client.aclose()
        finally:
            await bot.session.close()

{%- if hasUserbotNodes %}
        # Отключаем Telethon userbot
        if userbot_client and userbot_client.is_connected():
            await userbot_client.disconnect()
            logging.info("🟣 Telethon userbot отключён")
{%- endif %}


if __name__ == "__main__":
    asyncio.run(main())
