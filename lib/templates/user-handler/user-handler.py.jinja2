{#
  Шаблон обработчиков управления пользователями

  @fileoverview Генерирует Python обработчики для ban/unban/mute/unmute/promote/demote
  @param {string} nodeType     — тип узла
  @param {string} nodeId       — ID узла
  @param {string} safeName     — безопасное имя функции (safe_name от nodeId)
  @param {array}  synonyms     — список синонимов-триггеров
  @param {string} targetGroupId — ID конкретной группы (или '' для всех групп)

  ban_user:
    @param {string} reason     — причина бана
    @param {number} untilDate  — unix timestamp окончания бана (0 = навсегда)

  mute_user:
    @param {number} duration           — длительность в секундах
    @param {string} reason             — причина мута
    @param {bool}   canSendMessages
    @param {bool}   canSendAudios
    @param {bool}   canSendDocuments
    @param {bool}   canSendPhotos
    @param {bool}   canSendVideos
    @param {bool}   canSendVideoNotes
    @param {bool}   canSendVoiceNotes
    @param {bool}   canSendPolls
    @param {bool}   canSendOtherMessages
    @param {bool}   canAddWebPagePreviews
    @param {bool}   canReactToMessages
    @param {bool}   canChangeGroupInfo
    @param {bool}   canInviteUsers2
    @param {bool}   canPinMessages2

  promote_user:
    @param {bool} canChangeInfo
    @param {bool} canDeleteMessages
    @param {bool} canInviteUsers
    @param {bool} canRestrictMembers
    @param {bool} canPinMessages
    @param {bool} canPromoteMembers
    @param {bool} canManageVideoChats
    @param {bool} canManageTopics
    @param {bool} isAnonymous
    @param {bool} canManageChat — только если задано
    @param {bool} canPostMessages — только если задано
    @param {bool} canEditMessages — только если задано
    @param {bool} canManageDirectMessages — только если задано
    @param {bool} canManageTags — только если задано
    @param {bool} canSendWelcomeMessages — только если задано
#}

{# ── Вычисляем условие фильтрации чата ── #}
{% if targetGroupId %}
{% set chat_condition = 'str(message.chat.id) == "' ~ targetGroupId ~ '"' %}
{% else %}
{% set chat_condition = "message.chat.type in ['group', 'supergroup']" %}
{% endif %}

{# ── Синонимы в виде Python-списка строк ── #}
{% set synonyms_list = synonyms | join('", "') %}

{# Права ограничения: устаревшее общее медиа-поле в API не передаётся #}
{% macro mute_chat_permissions(can_send, can_audios, can_documents, can_photos, can_videos, can_video_notes, can_voice, can_polls, can_other, can_previews, can_react, can_change, can_invite, can_pin) %}
                can_send_messages={{ can_send | to_python_boolean }},
                can_send_audios={{ can_audios | to_python_boolean }},
                can_send_documents={{ can_documents | to_python_boolean }},
                can_send_photos={{ can_photos | to_python_boolean }},
                can_send_videos={{ can_videos | to_python_boolean }},
                can_send_video_notes={{ can_video_notes | to_python_boolean }},
                can_send_voice_notes={{ can_voice | to_python_boolean }},
                can_send_polls={{ can_polls | to_python_boolean }},
                can_send_other_messages={{ can_other | to_python_boolean }},
                can_add_web_page_previews={{ can_previews | to_python_boolean }},
                can_react_to_messages={{ can_react | to_python_boolean }},
                can_change_info={{ can_change | to_python_boolean }},
                can_invite_users={{ can_invite | to_python_boolean }},
                can_pin_messages={{ can_pin | to_python_boolean }}
{% endmacro %}

{# Снятие ограничения: текст, медиа, опросы, стикеры, превью и реакции #}
{% macro unmute_chat_permissions() %}
                can_send_messages=True,
                can_send_audios=True,
                can_send_documents=True,
                can_send_photos=True,
                can_send_videos=True,
                can_send_video_notes=True,
                can_send_voice_notes=True,
                can_send_polls=True,
                can_send_other_messages=True,
                can_add_web_page_previews=True,
                can_react_to_messages=True,
                can_change_info=False,
                can_invite_users=False,
                can_pin_messages=False
{% endmacro %}

{# Снятие администратора: False для всех boolean-прав ChatAdministratorRights #}
{% macro demote_admin_rights() %}
            is_anonymous=False,
            can_manage_chat=False,
            can_delete_messages=False,
            can_manage_video_chats=False,
            can_restrict_members=False,
            can_promote_members=False,
            can_change_info=False,
            can_invite_users=False,
            can_post_stories=False,
            can_edit_stories=False,
            can_delete_stories=False,
            can_post_messages=False,
            can_edit_messages=False,
            can_pin_messages=False,
            can_manage_topics=False,
            can_manage_direct_messages=False,
            can_manage_tags=False,
            can_send_welcome_messages=False
{% endmacro %}

{# Новое право назначения попадает в вызов только если оно задано в данных блока #}
{% macro optional_promote_right(py_name, value) %}
{%- if value is defined and value is not none %}
            {{ py_name }}={{ value | to_python_boolean }},
{%- endif %}
{% endmacro %}

