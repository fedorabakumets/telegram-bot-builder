{#
  @fileoverview Шаблон обработчиков возврата звёзд (refund_stars).
  Вызывает bot.refund_star_payment и при успехе переходит на autoTransitionTo.

  @param {array} entries - Массив RefundStarsEntry
#}

# Обработчики узлов возврата звёзд (refund_stars)
{% for entry in entries -%}
{%- set sanitized_node_id = entry.nodeId | safe_name -%}
{%- set sanitized_target_id = entry.targetNodeId | safe_name -%}

@dp.callback_query(lambda c: c.data == "{{ entry.nodeId }}")
async def handle_callback_{{ sanitized_node_id }}(callback_query: types.CallbackQuery, state: FSMContext = None):
    """Возврат звёзд — узел {{ entry.nodeId }}"""
    try:
        user_id = callback_query.from_user.id
        await init_user_variables(user_id, callback_query.from_user)
        try:
            await callback_query.answer()
        except Exception:
            pass

        _all_vars = await init_all_user_vars(user_id)
        if state is not None:
            try:
                _fsm_data = await state.get_data()
                if _fsm_data:
                    _all_vars.update(_fsm_data)
            except Exception:
                pass

        {% if entry.refundUserSource == 'custom' %}
        {%- set _user_raw = entry.refundUserId | trim %}
        {%- if '{' in _user_raw %}
        _user_id_raw = replace_variables_in_text({{ _user_raw | format_python_text }}, _all_vars, {})
        {%- else %}
        _user_id_raw = {{ _user_raw | escape_python_string }}
        {%- endif %}
        try:
            _refund_user_id = int(str(_user_id_raw).strip())
        except (ValueError, TypeError):
            logging.warning(f"⭐ refund_stars [{{ entry.nodeId }}]: неверный user_id из '{{ _user_raw }}'")
            raise ValueError("invalid refund user_id")
        {% else %}
        _refund_user_id = callback_query.from_user.id
        {% endif %}

        {%- set _charge_raw = entry.refundChargeId | trim %}
        {%- if '{' in _charge_raw %}
        _charge_id = replace_variables_in_text({{ _charge_raw | format_python_text }}, _all_vars, {})
        {%- else %}
        _charge_id = {{ _charge_raw | escape_python_string }}
        {%- endif %}
        _charge_id = str(_charge_id or "").strip()
        if not _charge_id:
            logging.warning(f"⭐ refund_stars [{{ entry.nodeId }}]: пустой код покупки")
            raise ValueError("empty refund charge id")

        await bot.refund_star_payment(
            user_id=_refund_user_id,
            telegram_payment_charge_id=_charge_id,
        )
        logging.info(
            f"⭐ refund_stars [{{ entry.nodeId }}]: возврат для {_refund_user_id}, charge={_charge_id}"
        )

        {% if entry.targetNodeId %}
        await handle_callback_{{ sanitized_target_id }}(callback_query, state=state)
        {% endif %}
    except Exception as _e:
        logging.error(f"❌ Ошибка refund_stars [{{ entry.nodeId }}]: {_e}")
        {% if entry.ignoreErrors %}
        {% if entry.targetNodeId %}
        await handle_callback_{{ sanitized_target_id }}(callback_query, state=state)
        {% endif %}
        {% else %}
        raise
        {% endif %}

{% endfor %}
