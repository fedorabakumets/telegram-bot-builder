{#
  Шаблон узла stop_processing — остановка цепочки middleware

  @fileoverview Устанавливает user_data[user_id]['_stop_processing'] = True
  @param {array} stopProcessingEntries - Массив объектов StopProcessingEntry
#}

# Обработчики узлов stop_processing
{% for entry in stopProcessingEntries %}
{%- set sanitized_node_id = entry.nodeId | safe_name -%}
@dp.callback_query(lambda c: c.data == "{{ entry.nodeId }}")
async def handle_callback_{{ sanitized_node_id }}(callback_query: types.CallbackQuery, state: FSMContext = None):
    """Узел stop_processing: останавливает дальнейшую обработку middleware."""
    try:
        user_id = callback_query.from_user.id
        if user_id not in user_data:
            user_data[user_id] = {}
        user_data[user_id]["_stop_processing"] = True
        logging.info(f"🛑 stop_processing [{{ entry.nodeId }}]: флаг _stop_processing установлен для {user_id}")
{% if entry.autoTransitionTo %}
        await handle_callback_{{ entry.autoTransitionTo | safe_name }}(callback_query, state=state)
{% endif %}
    except Exception as e:
        logging.error(f"❌ Ошибка в stop_processing [{{ entry.nodeId }}]: {e}")

{% endfor %}
