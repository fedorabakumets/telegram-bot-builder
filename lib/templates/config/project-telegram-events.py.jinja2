{# @fileoverview Доставка настоящих событий общего Telegram-клиента обработчикам раннера. #}
class _ProjectTelegramEventBridge:
    """Удерживает один запрос событий для всех обработчиков данного бота."""

    def _init_events(self):
        """Создаёт локальный реестр без подключения второй Telegram-сессии."""
        self._event_handlers = []
        self._event_task = None
        self._event_cursor = 0
        self._event_ready = asyncio.Event()
        self._event_failure = None
        self._event_callbacks = set()

    @staticmethod
    def _event_values(value):
        """Приводит одиночную цель или коллекцию целей к списку."""
        return [] if value is None else list(value) if isinstance(value, (list, tuple, set)) else [value]

    def add_event_handler(self, callback, event=None):
        """Регистрирует поддерживаемый Telethon builder и обновляет общий запрос событий."""
        builder = event() if isinstance(event, type) else event
        if not isinstance(builder, (_project_telegram_events.NewMessage, _project_telegram_events.MessageEdited)):
            raise ValueError("Общий Telegram-клиент поддерживает только NewMessage и MessageEdited")
        targets = self._event_values(builder.chats) + self._event_values(builder.from_users)
        if any(type(target) not in (str, int) for target in targets):
            raise ValueError("Для событий общего аккаунта задайте имя чата или числовой идентификатор")
        if any(type(target) is not int for target in self._event_values(builder.from_users)):
            raise ValueError("Фильтр from_users общего аккаунта принимает числовые идентификаторы")
        if len(set(map(str, targets))) > 30:
            raise ValueError("Подписка допускает не более 30 целей")
        all_targets = {str(target) for _, existing in self._event_handlers for target in self._event_values(existing.chats)}
        all_targets.update(str(target) for target in self._event_values(builder.chats))
        if len(all_targets) > 30:
            raise ValueError("Общая подписка допускает не более 30 чатов")
        self._event_handlers.append((callback, builder))
        self._restart_events()

    def remove_event_handler(self, callback, event=None):
        """Удаляет обработчики без отключения общего клиента других ботов."""
        previous = len(self._event_handlers)
        self._event_handlers = [(fn, builder) for fn, builder in self._event_handlers
                                if fn != callback or (event is not None and not (
                                    isinstance(builder, event) if isinstance(event, type) else builder is event))]
        self._restart_events()
        return previous - len(self._event_handlers)

    def on(self, event):
        """Возвращает декоратор подписки с тем же обработчиком, что у Telethon."""
        def register(callback):
            """Добавляет обработчик в локальную подписку данного бота."""
            self.add_event_handler(callback, event)
            return callback
        return register

    def _restart_events(self):
        """Отменяет старое ожидание и выставляет барьер перед следующей отправкой."""
        if self._event_task:
            self._event_task.cancel()
        self._event_task = None
        self._event_ready.clear()
        self._event_failure = None
        if self._connected and self._event_handlers:
            self._event_task = asyncio.get_running_loop().create_task(self._poll_events())

    async def ensure_event_subscription(self):
        """Дожидается регистрации подписки до отправки сообщения или нажатия кнопки."""
        if not self._connected or not self._event_handlers:
            return
        if self._event_failure:
            raise self._event_failure
        if not self._event_task or self._event_task.done():
            self._restart_events()
        await asyncio.wait_for(self._event_ready.wait(), timeout=30)
        if self._event_failure:
            raise self._event_failure

    async def _stop_events(self):
        """Закрывает локальное ожидание событий при остановке только этого бота."""
        task, self._event_task = self._event_task, None
        if task:
            task.cancel()
            try:
                await task
            except asyncio.CancelledError:
                pass
        self._event_ready.clear()

        callbacks = [task for task in self._event_callbacks if task is not asyncio.current_task()]
        for callback_task in callbacks:
            callback_task.cancel()
        if callbacks:
            await asyncio.gather(*callbacks, return_exceptions=True)

    async def _dispatch_event(self, item, resolved):
        """Применяет фильтры настоящих Telethon builders к DTO входящего события."""
        for callback, original in list(self._event_handlers):
            edited = isinstance(original, _project_telegram_events.MessageEdited)
            if (item["kind"] == "edited") != edited:
                continue
            builder = _project_telegram_copy.copy(original)
            def ids(value):
                """Сопоставляет имена целей с отмеченными идентификаторами брокера."""
                return {resolved.get(str(target), target) for target in self._event_values(value)} if value is not None else None
            builder.chats, builder.from_users, builder.resolved = ids(original.chats), ids(original.from_users), True
            message = self._message(item["message"], item["chat_id"])
            message.message = message.text
            message.fwd_from = getattr(message, "fwd_from", None)
            event = SimpleNamespace(message=message, chat_id=item["chat_id"], sender_id=message.sender_id,
                                    raw_text=message.raw_text, id=message.id, client=self, pattern_match=None,
                                    is_private=item.get("is_private", item["chat_id"] > 0),
                                    is_channel=item.get("is_channel", item["chat_id"] <= -1000000000000),
                                    is_group=item.get("is_group", -1000000000000 < item["chat_id"] < 0), out=message.out)
            try:
                accepted = builder.filter(event)
                if _project_telegram_inspect.isawaitable(accepted):
                    accepted = await accepted
                if accepted:
                    if len(self._event_callbacks) >= 64:
                        raise RuntimeError("Превышен лимит обработчиков событий общего аккаунта")
                    task = asyncio.create_task(self._run_event_callback(callback, event))
                    self._event_callbacks.add(task)
                    task.add_done_callback(self._event_callbacks.discard)
            except Exception:
                logging.exception("Ошибка обработчика события Telegram-аккаунта проекта")

    async def _run_event_callback(self, callback, event):
        """Изолирует выполнение сценария от long-poll и изменения списка подписок."""
        try:
            await callback(event)
        except Exception:
            logging.exception("Ошибка сценария события Telegram-аккаунта проекта")

    async def _poll_events(self):
        """Читает bounded-журнал настоящих обновлений, не извлекая события из истории чата."""
        initial = True
        try:
            while self._connected and self._event_handlers:
                builders = [builder for _, builder in self._event_handlers]
                all_chats = any(builder.chats is None or builder.blacklist_chats for builder in builders)
                resolved_targets = list(dict.fromkeys(target for builder in builders for target in self._event_values(builder.chats)))
                targets = [] if all_chats else resolved_targets
                if len(resolved_targets) > 30:
                    raise ValueError("Общая подписка допускает не более 30 чатов")
                result = await self._execute("events_poll", targets=targets, resolve_targets=resolved_targets,
                                             after=self._event_cursor, wait_seconds=0 if initial else 20)
                self._event_cursor = result["cursor"]
                self._event_ready.set()
                initial = False
                for item in result.get("events", []):
                    await self._dispatch_event(item, result.get("resolved_targets", {}))
                await asyncio.sleep(0)
        except asyncio.CancelledError:
            raise
        except Exception as error:
            self._event_failure = error
            self._event_ready.set()
            logging.exception("Доставка событий Telegram-аккаунта проекта остановлена")
