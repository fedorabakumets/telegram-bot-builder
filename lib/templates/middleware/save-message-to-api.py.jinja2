{# @fileoverview Атомарное сохранение переписки, идемпотентной аналитики и уведомлений после commit. #}

async def _save_message_once(user_id: str, message_type: str, message_text: str = None, node_id: str = None, message_data: dict = None, chat_type: str = 'private', chat_id: str = None, analytics_event: dict = None, start_payload: str = None):
    """Сохраняет переписку и аналитический факт в одной транзакции; повтор не увеличивает счётчики."""
    if not db_pool:
        raise ConnectionError('Пул аналитики ещё недоступен')
    try:
        message_data = dict(message_data or {})
        if message_type == 'bot' and not message_data.get('message_id') and node_id:
            # Уточнение ноды после send_* относится к той же отправке в текущей задаче.
            sent = _analytics_last_outgoing.get()
            if sent:
                user_id, chat_type, chat_id = sent['user_id'], sent['chat_type'], sent['chat_id']
                message_data = {**message_data, **sent['message_data']}
        context = _analytics_incoming_context.get() if message_type == 'user' else None
        if context and not analytics_event:
            analytics_event = context.get('event')
            start_payload = context.get('start_payload')
            chat_type, chat_id = context['chat_type'], context['chat_id']
            if context.get('message_id'):
                message_data.setdefault('message_id', context['message_id'])
        if message_type == 'bot' and analytics_event is None:
            analytics_event = _analytics_outgoing_event(user_id, message_data, chat_type, chat_id)
        message_text = _analytics_safe_value(message_text)
        message_data = _analytics_safe_value(message_data)
        async with db_pool.acquire() as conn:
            async with conn.transaction():
                outcome = await _analytics_write_event(conn, analytics_event, start_payload)
                if outcome and outcome.get('discarded'):
                    if outcome.get('reason') == 'resource_deleted':
                        _analytics_discard_deleted_scope()
                    return None
                if outcome and not outcome.get('inserted', False):
                    # Повтор обёртки возвращает прежнюю запись для привязки медиа к сообщению.
                    existing = await conn.fetchrow("SELECT id,user_id,message_type,created_at FROM bot_messages WHERE project_id=$1 AND token_id=$2 AND user_id=$3 AND message_type=$4 AND telegram_message_id=$5 AND chat_type=$6 AND chat_id IS NOT DISTINCT FROM $7 ORDER BY id LIMIT 1",
                        PROJECT_ID, TOKEN_ID, str(user_id), message_type, message_data.get('message_id'), chat_type, chat_id)
                    if existing:
                        # Обёртка дополняет запись клавиатурой и нодой, не затирая уже сохранённые данные Telegram.
                        await conn.execute("""UPDATE bot_messages SET node_id=COALESCE(node_id,$1),
                            message_data=jsonb_strip_nulls($2::jsonb) || jsonb_strip_nulls(COALESCE(message_data,'{}'::jsonb))
                            WHERE id=$3 AND project_id=$4 AND token_id=$5""",
                            node_id, json.dumps(message_data,ensure_ascii=False), existing['id'], PROJECT_ID, TOKEN_ID)
                    return existing
                # Старые ноды дополнительно логируют отправку без Telegram ID: это не второе сообщение.
                if message_type == 'bot' and not analytics_event:
                    return None
                result = await conn.fetchrow("""
                    INSERT INTO bot_messages (project_id,token_id,user_id,message_type,message_text,node_id,message_data,telegram_message_id,chat_type,chat_id,created_at)
                    VALUES ($1,$2,$3,$4,$5,$6,$7::jsonb,$8,$9,$10,NOW())
                    RETURNING id,user_id,message_type,created_at
                """, PROJECT_ID,TOKEN_ID,str(user_id),message_type,message_text,node_id,
                    json.dumps(message_data,ensure_ascii=False),message_data.get('message_id'),chat_type,chat_id)
                # Старые контракты сохраняют прежнюю методику; новая аналитика читает отдельные факты.
                async with conn.transaction():
                    await conn.execute("""
                        INSERT INTO message_activity_daily(project_id,token_id,day,incoming_count,outgoing_count)
                        VALUES($1,$2,CURRENT_DATE,$3,$4)
                        ON CONFLICT(project_id,token_id,day) DO UPDATE SET
                        incoming_count=message_activity_daily.incoming_count+EXCLUDED.incoming_count,
                        outgoing_count=message_activity_daily.outgoing_count+EXCLUDED.outgoing_count
                    """, PROJECT_ID,TOKEN_ID,1 if message_type=='user' else 0,0 if message_type=='user' else 1)
                if message_type == 'user':
                    await conn.execute("""
                        INSERT INTO user_activity_daily(project_id,token_id,day,user_id,first_seen_at)
                        VALUES($1,$2,CURRENT_DATE,$3,COALESCE((SELECT registered_at FROM bot_users
                          WHERE project_id=$1 AND token_id=$2 AND user_id=$3),NOW()))
                        ON CONFLICT(project_id,token_id,day,user_id) DO NOTHING
                    """, PROJECT_ID,TOKEN_ID,int(user_id))
        # Redis обслуживает старую ленту; аналитический outbox уже зафиксирован в PostgreSQL.
        if _redis_client:
            try:
                await _redis_client.publish(f'bot:message:{PROJECT_ID}:{TOKEN_ID}',json.dumps({
                    'userId':str(user_id),'messageType':message_type,'messageText':message_text,
                    'messageData':message_data,'nodeId':node_id,'id':result['id'],
                    'createdAt':result['created_at'].isoformat(),'chatId':chat_id,'chatType':chat_type,
                },ensure_ascii=False))
            except Exception:
                logging.warning('Redis: переписка записана; уведомление восстановится после подключения')
        return dict(result)
    except Exception as error:
        raise


_analytics_persistence_tasks = set()


async def save_message_to_api(user_id: str, message_type: str, message_text: str = None, node_id: str = None, message_data: dict = None, chat_type: str = 'private', chat_id: str = None, analytics_event: dict = None, start_payload: str = None):
    """Фиксирует минимальный факт на диске, затем пишет переписку; сбой продолжит фоновая очередь."""
    if _analytics_scope_deleted:
        return None
    message_data = dict(message_data or {})
    if message_type == 'bot' and not message_data.get('message_id') and node_id:
        sent = _analytics_last_outgoing.get()
        if sent:
            user_id, chat_type, chat_id = sent['user_id'], sent['chat_type'], sent['chat_id']
            message_data.update(sent['message_data'])
    context = _analytics_incoming_context.get() if message_type == 'user' else None
    if context and not analytics_event:
        analytics_event, start_payload = context.get('event'), context.get('start_payload')
        chat_type, chat_id = context['chat_type'], context['chat_id']
        if context.get('message_id'):
            message_data.setdefault('message_id', context['message_id'])
    if message_type == 'bot' and analytics_event is None:
        analytics_event = _analytics_outgoing_event(user_id, message_data, chat_type, chat_id)
    key = None
    try:
        key = _analytics_spool_store(analytics_event, start_payload)
    except Exception as error:
        logging.critical('Локальная очередь аналитики недоступна, тип %s', type(error).__name__)
    async with _analytics_delivery_lock:
        try:
            result = await asyncio.wait_for(_save_message_once(user_id,message_type,message_text,node_id,message_data,chat_type,chat_id,analytics_event,start_payload), timeout=10)
            _analytics_spool_ack(key)
            return result
        except Exception as error:
            if analytics_event and not key:
                logging.critical('Аналитический факт не сохранён: одновременно недоступны БД и локальная очередь, тип %s', type(error).__name__)
            else:
                logging.warning('Запись аналитики отложена до восстановления БД, тип %s', type(error).__name__)
    return None


async def _analytics_drain_pending():
    """Ограничивает остановку десятью секундами; оставшиеся факты восстанавливаются с диска."""
    async def drain():
        """Завершает уже запущенные операции и пробует оставшуюся очередь."""
        if _analytics_persistence_tasks:
            await asyncio.gather(*tuple(_analytics_persistence_tasks), return_exceptions=True)
        await _analytics_spool_flush(force=True)
    try:
        await asyncio.wait_for(drain(), timeout=10)
    except asyncio.TimeoutError:
        logging.warning('Остановка аналитики: оставшиеся факты сохранены для следующего запуска')


def _fire_save_message(user_id: str, message_type: str, message_text: str = None, node_id: str = None, message_data: dict = None, chat_type: str = 'private', chat_id: str = None, analytics_event: dict = None, start_payload: str = None):
    """Запускает безопасную запись после успешного ответа Telegram; контекст сохраняется задачей."""
    task = asyncio.create_task(save_message_to_api(user_id,message_type,message_text,node_id,message_data,chat_type,chat_id,analytics_event,start_payload))
    _analytics_persistence_tasks.add(task)
    task.add_done_callback(_analytics_persistence_tasks.discard)

