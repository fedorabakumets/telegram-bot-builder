async def _save_incoming_photo_to_db(file_id: str, user_id: str, telegram_message_id: int, chat_type: str, chat_id: str):
    """Сохраняет входящее фото через ограниченный API проекта и связывает с точным сообщением."""
    if not db_pool:
        return
    try:
        import os as _os
        import aiohttp as _aiohttp
        _base = _os.getenv('MEDIA_RUNTIME_BASE_URL', '').rstrip('/')
        _token = _os.getenv('MEDIA_RUNTIME_WRITE_TOKEN', '')
        if not _base or not _token:
            logging.warning('Сохранение входящего фото: доступ к хранилищу не настроен')
            return
        async with db_pool.acquire() as _conn:
            _row = await _conn.fetchrow(
                """SELECT id FROM bot_messages WHERE project_id=$1 AND token_id=$2 AND user_id=$3
                   AND message_type='user' AND telegram_message_id=$4 AND chat_type=$5
                   AND chat_id IS NOT DISTINCT FROM $6 ORDER BY id LIMIT 1""",
                PROJECT_ID, TOKEN_ID, user_id, telegram_message_id, chat_type, chat_id)
        if not _row:
            logging.warning('Сохранение входящего фото: сообщение не найдено')
            return
        _timeout = _aiohttp.ClientTimeout(total=60)
        async with _aiohttp.ClientSession(timeout=_timeout) as _session:
            async with _session.get(f"{TELEGRAM_BOT_API_URL or 'https://api.telegram.org'}/bot{BOT_TOKEN}/getFile", params={'file_id': file_id}) as _resp:
                _data = await _resp.json()
                if _resp.status != 200 or not _data.get('ok'):
                    logging.warning('Telegram не предоставил входящее фото')
                    return
                _file = _data['result']
                if _file.get('file_size', 0) > 20 * 1024 * 1024:
                    logging.warning('Входящее фото превышает допустимый размер')
                    return
            _media = None
            for _attempt in range(3):
                async with _session.get(f"{TELEGRAM_BOT_API_URL or 'https://api.telegram.org'}/file/bot{BOT_TOKEN}/{_file['file_path']}") as _source:
                    if _source.status != 200:
                        logging.warning('Не удалось скачать входящее фото из Telegram')
                        return
                    async with _session.post(_base + '/api/runtime/media/incoming-photo',
                            params={'projectId': PROJECT_ID}, data=_source.content,
                            headers={'Authorization': 'Bearer ' + _token, 'Content-Type': 'image/jpeg'}) as _saved:
                        if _saved.status == 429:
                            try:
                                _wait = min(3600, max(1, int(_saved.headers.get('Retry-After', '60'))))
                            except ValueError:
                                _wait = 60
                            logging.warning('Лимит входящих фото: повтор через %s секунд', _wait)
                        elif _saved.status != 200:
                            logging.warning('Не удалось сохранить входящее фото: HTTP %s', _saved.status)
                            return
                        else:
                            _media = await _saved.json()
                            break
                if _attempt < 2:
                    await asyncio.sleep(_wait)
            if _media is None:
                logging.error('Входящее фото не сохранено после повторных попыток')
                return
            if _media.get('quotaExceeded'):
                logging.warning('Мягкая квота локального хранилища превышена')
        async with db_pool.acquire() as _conn:
            async with _conn.transaction():
                await _conn.execute("INSERT INTO bot_message_media (message_id, media_file_id, media_kind, order_index) VALUES ($1, $2, 'photo', 0)", _row['id'], _media['id'])
                await _conn.execute("UPDATE bot_messages SET primary_media_id=$1 WHERE id=$2 AND project_id=$3", _media['id'], _row['id'], PROJECT_ID)
    except Exception as _e:
        logging.warning('Не удалось сохранить входящее фото: %s', type(_e).__name__)
{% endif %}
