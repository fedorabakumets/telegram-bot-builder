{% if entry.autoTransitionTo %}
{%- set sanitized_next_id = entry.autoTransitionTo | safe_name %}
    class FakeCallbackQuery:
        def __init__(self, user, msg, data):
            self.from_user = user
            self.message = msg
            self.data = data
            self._is_fake = True

        async def answer(self, *args, **kwargs):
            pass

    fake_cb = FakeCallbackQuery(callback_query.from_user, callback_query.message, "{{ entry.autoTransitionTo }}")
    await handle_callback_{{ sanitized_next_id }}(fake_cb, state=state)
{% endif %}

{% endfor %}
{% endif %}

{% if has_invoices %}
@dp.pre_checkout_query()
async def on_pre_checkout_query_stars(pre_checkout_query: types.PreCheckoutQuery):
    """Проверка перед списанием звёзд — всегда разрешаем"""
    logging.info(
        f"⭐ pre_checkout: payload={pre_checkout_query.invoice_payload} amount={pre_checkout_query.total_amount}"
    )
    await pre_checkout_query.answer(ok=True)

@dp.shipping_query()
async def on_shipping_query_stars(shipping_query: types.ShippingQuery):
    """Демо-доставка: один бесплатный вариант (для need_shipping_address)"""
    from aiogram.types import LabeledPrice as _LP, ShippingOption as _SO
    try:
        await bot.answer_shipping_query(
            shipping_query_id=shipping_query.id,
            ok=True,
            shipping_options=[
                _SO(id="free", title="Бесплатная доставка", prices=[_LP(label="Доставка", amount=0)])
            ],
        )
    except Exception as _ship_err:
        logging.error(f"❌ shipping_query: {_ship_err}")
{% endif %}

{%- if has_invoices or has_triggers %}
@dp.message(F.successful_payment)
async def on_successful_payment_stars(message: types.Message, state: FSMContext = None):
    """Успешная оплата звёздами — счёт/ссылка, иначе триггер по метке"""
    payment = message.successful_payment
    if not payment:
        return
    payload = payment.invoice_payload or ""
    user_id = message.from_user.id
    await init_user_variables(user_id, message.from_user)
    logging.info(
        f"⭐ successful_payment: payload={payload} amount={payment.total_amount} charge={payment.telegram_payment_charge_id}"
    )

    if user_id not in user_data:
        user_data[user_id] = {}

    class FakeCallbackQuery:
        """Фейковый callback для перехода после оплаты"""
        def __init__(self, user, msg, data):
            self.from_user = user
            self.message = msg
            self.data = data
            self._is_fake = True

        async def answer(self, *args, **kwargs):
            pass

    _route = _stars_payment_targets.get(payload)
    if _route:
        _amount_var = _route.get("save_amount_to") or ""
        if _amount_var:
            user_data[user_id][_amount_var] = payment.total_amount

        _charge_var = _route.get("save_charge_to") or ""
        if _charge_var:
            user_data[user_id][_charge_var] = payment.telegram_payment_charge_id

        _oi = getattr(payment, "order_info", None)
        _name_var = _route.get("save_name_to") or ""
        if _name_var:
            user_data[user_id][_name_var] = getattr(_oi, "name", None) or ""
        _email_var = _route.get("save_email_to") or ""
        if _email_var:
            user_data[user_id][_email_var] = getattr(_oi, "email", None) or ""
        _phone_var = _route.get("save_phone_to") or ""
        if _phone_var:
            user_data[user_id][_phone_var] = getattr(_oi, "phone_number", None) or ""

        _next = _route.get("next_node") or ""
        if not _next:
            return

        fake_cb = FakeCallbackQuery(message.from_user, message, _next)
{% for entry in sendInvoiceEntries %}
{%- if entry.autoTransitionTo %}
{%- set sanitized_target_id = entry.autoTransitionTo | safe_name %}
        if _next == "{{ entry.autoTransitionTo }}":
            await handle_callback_{{ sanitized_target_id }}(fake_cb, state=state)
            return
{% endif %}
{% endfor %}
{% for entry in createInvoiceLinkEntries %}
{%- if entry.afterPaymentTo %}
{%- set sanitized_target_id = entry.afterPaymentTo | safe_name %}
        if _next == "{{ entry.afterPaymentTo }}":
            await handle_callback_{{ sanitized_target_id }}(fake_cb, state=state)
            return
{% endif %}
{% endfor %}
        return

{% if has_triggers %}
    _spt = None
{% for entry in successfulPaymentTriggerEntries %}
{% if entry.payloadFilter == 'exact' %}
    if _spt is None and payload == {{ entry.payloadValue | tojson }}:
{% elif entry.payloadFilter == 'starts_with' %}
    if _spt is None and str(payload).startswith({{ entry.payloadValue | tojson }}):
{% else %}
    if _spt is None:
{% endif %}
        _spt = {
            "node_id": "{{ entry.nodeId }}",
            "save_amount_to": {{ entry.savePaymentAmountTo | tojson }},
            "save_charge_to": {{ entry.savePaymentChargeIdTo | tojson }},
            "next_node": {{ entry.targetNodeId | tojson }},
        }
{% endfor %}

    if _spt is None:
        logging.warning(f"⭐ successful_payment: неизвестный payload={payload!r}, триггер не найден")
        return

    logging.info(f"⭐ successful_payment_trigger [{_spt.get('node_id')}]: payload={payload!r}")

    _amount_var = _spt.get("save_amount_to") or ""
    if _amount_var:
        user_data[user_id][_amount_var] = payment.total_amount

    _charge_var = _spt.get("save_charge_to") or ""
    if _charge_var:
        user_data[user_id][_charge_var] = payment.telegram_payment_charge_id

    _next = _spt.get("next_node") or ""
    if not _next:
        return

    fake_cb = FakeCallbackQuery(message.from_user, message, _next)
{% for entry in successfulPaymentTriggerEntries %}
{%- if entry.targetNodeId %}
{%- set sanitized_target_id = entry.targetNodeId | safe_name %}
    if _next == "{{ entry.targetNodeId }}":
        await handle_callback_{{ sanitized_target_id }}(fake_cb, state=state)
        return
{% endif %}
{% endfor %}
{% else %}
    logging.warning(f"⭐ successful_payment: неизвестный payload={payload!r}")
{% endif %}

{%- endif %}
