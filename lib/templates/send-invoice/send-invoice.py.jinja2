{#
  @fileoverview Шаблон счетов в чат, ссылок на счёт и общего роутера оплаты.
  1) handle_callback — answer_invoice (send_invoice)
  2) handle_callback — create_invoice_link + save URL + переход
  3) pre_checkout — если есть счёт или ссылка
  4) successful_payment — targets → триггер

  @param {array} sendInvoiceEntries
  @param {array} createInvoiceLinkEntries
  @param {array} successfulPaymentTriggerEntries
#}

{%- set has_chat = sendInvoiceEntries and sendInvoiceEntries|length > 0 -%}
{%- set has_links = createInvoiceLinkEntries and createInvoiceLinkEntries|length > 0 -%}
{%- set has_invoices = has_chat or has_links -%}
{%- set has_triggers = successfulPaymentTriggerEntries and successfulPaymentTriggerEntries|length > 0 -%}

{% if has_invoices or has_triggers %}
# Маршруты оплаты: payload → настройки узла счёта / ссылки
_stars_payment_targets = {}
{% endif %}

{% if has_chat %}
# Обработчики счетов в звёздах (send_invoice)
{% for entry in sendInvoiceEntries %}
{%- set sanitized_node_id = entry.nodeId | safe_name %}
@dp.callback_query(lambda c: c.data == "{{ entry.nodeId }}")
async def handle_callback_{{ sanitized_node_id }}(callback_query: types.CallbackQuery, state: FSMContext = None):
    """Выставляет счёт в звёздах — узел {{ entry.nodeId }}"""
    user_id = callback_query.from_user.id
    await init_user_variables(user_id, callback_query.from_user)
    try:
        await callback_query.answer()
    except Exception:
        pass

    _all_vars = await init_all_user_vars(user_id)
    if state is not None:
        try:
            _fsm_data = await state.get_data()
            if _fsm_data:
                _all_vars.update(_fsm_data)
        except Exception:
            pass

    _title = replace_variables_in_text({{ entry.title | tojson }}, _all_vars, {})
    _description = replace_variables_in_text({{ entry.description | tojson }}, _all_vars, {})

    _payload = replace_variables_in_text({{ entry.payload | tojson }}, _all_vars, {}) or "{{ entry.nodeId }}"
    _payload = str(_payload)[:128]
{% if entry.photoUrl %}
    _photo_url = replace_variables_in_text({{ entry.photoUrl | tojson }}, _all_vars, {})
    if isinstance(_photo_url, str) and _photo_url.startswith("/uploads/"):
        _api_base = (os.getenv("API_BASE_URL") or "").rstrip("/")
        if _api_base:
            _photo_url = f"{_api_base}{_photo_url}"
        else:
            logging.warning(
                f"⭐ send_invoice [{{ entry.nodeId }}]: нет API_BASE_URL — картинка /uploads/ пропущена"
            )
            _photo_url = ""
{% else %}
    _photo_url = ""
{% endif %}

    _currency = str(replace_variables_in_text({{ entry.currency | tojson }}, _all_vars, {}) or "XTR").upper().strip() or "XTR"
    # Неподставленный {var} / мусор → CURRENCY_INVALID у Telegram
    import re as _re_cur
    if "{" in _currency or not _re_cur.fullmatch(r"[A-Z]{3}", _currency):
        logging.error(
            f"❌ send_invoice [{{ entry.nodeId }}]: некорректная валюта {_currency!r} (проверьте переменную invoiceCurrency)"
        )
        await callback_query.message.answer(
            "Не задана валюта счёта. Выберите валюту в меню или задайте invoiceCurrency."
        )
        return
{% if entry.providerSource == 'env' %}
    _provider_token = "" if _currency == "XTR" else (os.getenv({{ entry.providerTokenEnv | tojson }}) or "")
{% else %}
    _provider_token = "" if _currency == "XTR" else {{ entry.providerToken | tojson }}
{% endif %}
    if _currency != "XTR" and not str(_provider_token or "").strip():
        logging.error(
            f"❌ send_invoice [{{ entry.nodeId }}]: пустой provider_token для валюты {_currency}"
        )
        await callback_query.message.answer(
            "Не задан токен платёжного провайдера. Укажите его в ноде или в переменной окружения бота."
        )
        return

    _invoice_kwargs = {
        "title": (_title or "Товар")[:32],
        "description": (_description or "Описание")[:255],
        "payload": _payload,
        "provider_token": _provider_token,
        "currency": _currency,
    }
{% include 'send-invoice/invoice-kwargs-common.py.jinja2' %}
{# Подписка только через createInvoiceLink: sendInvoice → SUBSCRIPTION_EXPORT_MISSING #}
{% if entry.protectContent %}
    _invoice_kwargs["protect_content"] = True
{% endif %}
{% if entry.disableNotification %}
    _invoice_kwargs["disable_notification"] = True
{% endif %}
{% if entry.allowPaidBroadcast %}
    _invoice_kwargs["allow_paid_broadcast"] = True
{% endif %}
{% if entry.startParameter %}
    _sp = replace_variables_in_text({{ entry.startParameter | tojson }}, _all_vars, {})
    if str(_sp or "").strip():
        _invoice_kwargs["start_parameter"] = str(_sp)
{% endif %}
{% if entry.messageThreadId %}
    try:
        _tid = int(float(str(replace_variables_in_text({{ entry.messageThreadId | tojson }}, _all_vars, {}) or "0")))
        if _tid > 0:
            _invoice_kwargs["message_thread_id"] = _tid
    except (ValueError, TypeError):
        pass
{% endif %}
{% if entry.directMessagesTopicId %}
    try:
        _dmt = int(float(str(replace_variables_in_text({{ entry.directMessagesTopicId | tojson }}, _all_vars, {}) or "0")))
        if _dmt > 0:
            _invoice_kwargs["direct_messages_topic_id"] = _dmt
    except (ValueError, TypeError):
        pass
{% endif %}
{% if entry.replyToMessageId %}
    try:
        _rid = int(float(str(replace_variables_in_text({{ entry.replyToMessageId | tojson }}, _all_vars, {}) or "0")))
        if _rid > 0:
            _invoice_kwargs["reply_to_message_id"] = _rid
    except (ValueError, TypeError):
        pass
{% endif %}
{% if entry.messageEffectId %}
    _eff = replace_variables_in_text({{ entry.messageEffectId | tojson }}, _all_vars, {})
    if str(_eff or "").strip():
        _invoice_kwargs["message_effect_id"] = str(_eff)
{% endif %}
{% if entry.suggestedPostParams %}
    _spp = replace_variables_in_text({{ entry.suggestedPostParams | tojson }}, _all_vars, {})
    if str(_spp or "").strip():
        try:
            import json as _json_spp
            _invoice_kwargs["suggested_post_parameters"] = _json_spp.loads(str(_spp))
        except Exception:
            logging.warning(f"⭐ send_invoice [{{ entry.nodeId }}]: некорректный suggested_post_parameters JSON")
{% endif %}

    _stars_payment_targets[_payload] = {
        "node_id": "{{ entry.nodeId }}",
        "save_amount_to": {{ entry.savePaymentAmountTo | tojson }},
        "save_charge_to": {{ entry.savePaymentChargeIdTo | tojson }},
        "save_name_to": {{ entry.saveOrderNameTo | tojson }},
        "save_email_to": {{ entry.saveOrderEmailTo | tojson }},
        "save_phone_to": {{ entry.saveOrderPhoneTo | tojson }},
        "next_node": {{ entry.autoTransitionTo | tojson }},
    }

{% if entry.hasKeyboard %}
    all_user_vars = _all_vars
{%- set nodeId = entry.nodeId -%}
{%- set keyboardType = 'inline' -%}
{%- set buttons = entry.buttons -%}
{%- set keyboardLayout = entry.keyboardLayout -%}
{%- set adjustStr = entry.adjustStr -%}
{%- set allowMultipleSelection = false -%}
{%- set enableDynamicButtons = false -%}
{%- set shuffleButtons = false -%}
{%- filter indent(4) %}{% include 'keyboard/keyboard.py.jinja2' %}{% endfilter %}
    _invoice_kwargs["reply_markup"] = keyboard
{% endif %}

    try:
        await callback_query.message.answer_invoice(**_invoice_kwargs)
        logging.info(
            f"⭐ send_invoice [{{ entry.nodeId }}]: счёт {_amount} {_currency} для {user_id}, payload={_payload}"
        )
    except Exception as e:
        logging.error(f"❌ Ошибка send_invoice [{{ entry.nodeId }}]: {e}")

{% endfor %}
{% endif %}

{% if has_links %}
# Обработчики ссылок на счёт (create_invoice_link)
{% for entry in createInvoiceLinkEntries %}
{%- set sanitized_node_id = entry.nodeId | safe_name %}
