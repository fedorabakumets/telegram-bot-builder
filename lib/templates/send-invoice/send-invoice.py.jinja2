    }
{% include 'send-invoice/invoice-kwargs-common.py.jinja2' %}
{% if entry.subscription %}
    if _currency == "XTR":
        _invoice_kwargs["subscription_period"] = 2592000
{% endif %}

    _stars_payment_targets[_payload] = {
        "node_id": "{{ entry.nodeId }}",
        "save_amount_to": {{ entry.savePaymentAmountTo | tojson }},
        "save_charge_to": {{ entry.savePaymentChargeIdTo | tojson }},
        "save_name_to": {{ entry.saveOrderNameTo | tojson }},
        "save_email_to": {{ entry.saveOrderEmailTo | tojson }},
        "save_phone_to": {{ entry.saveOrderPhoneTo | tojson }},
        "next_node": {{ entry.afterPaymentTo | tojson }},
    }

    try:
        # Глобальный bot: MockCallback (из command_trigger) не имеет .bot
        _invoice_link = await bot.create_invoice_link(**_invoice_kwargs)
        logging.info(
            f"⭐ create_invoice_link [{{ entry.nodeId }}]: ссылка {_amount} {_currency} для {user_id}, payload={_payload}"
        )
    except Exception as e:
        logging.error(f"❌ Ошибка create_invoice_link [{{ entry.nodeId }}]: {e}")
