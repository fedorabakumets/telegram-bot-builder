{% else %}
    _photo_url = ""
{% endif %}

    _currency = str(replace_variables_in_text({{ entry.currency | tojson }}, _all_vars, {}) or "XTR").upper().strip() or "XTR"
    import re as _re_cur_link
    if "{" in _currency or not _re_cur_link.fullmatch(r"[A-Z]{3}", _currency):
        logging.error(
            f"❌ create_invoice_link [{{ entry.nodeId }}]: некорректная валюта {_currency!r}"
        )
        await callback_query.message.answer(
            "Не задана валюта счёта. Выберите валюту в меню или задайте invoiceCurrency."
