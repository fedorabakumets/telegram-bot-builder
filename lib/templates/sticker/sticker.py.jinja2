{#
  Шаблон шага сценария «стикер».

  @fileoverview Отправка стикера, когда сценарий дошёл до блока
  (кнопка или автопереход). Команда Command() не регистрируется.
  У sendSticker нет параметра caption — подпись не передаётся.

  @param {string} nodeId - ID узла, он же callback_data
  @param {string} stickerUrl - HTTP(S) URL или локальный путь /uploads/
  @param {string} stickerFileId - file_id стикера
  @param {string} stickerSetName - запасной идентификатор стикера
  @param {boolean} disableNotification - отправить без звука
  @param {boolean} isLocalStickerUrl - stickerUrl начинается с /uploads/
  @param {string} autoTransitionTo - ID следующего узла
#}
@dp.callback_query(lambda c: c.data == "{{ nodeId }}")
async def handle_callback_{{ nodeId|safe_name }}(callback_query: types.CallbackQuery, state: FSMContext = None):
    """Отправка стикера при входе в узел {{ nodeId }}"""
    try:
        await callback_query.answer()
    except Exception:
        pass

    user_id = callback_query.from_user.id
    _chat_id = callback_query.message.chat.id if callback_query.message else user_id

    try:
        {% if stickerFileId %}
        await bot.send_sticker(
            chat_id=_chat_id,
            sticker="{{ stickerFileId|e }}"{% if disableNotification %},
            disable_notification=True{% endif %}
        )
        {% elif isLocalStickerUrl %}
        _sticker_file = FSInputFile(get_upload_file_path("{{ stickerUrl|e }}"))
        await bot.send_sticker(
            chat_id=_chat_id,
            sticker=_sticker_file{% if disableNotification %},
            disable_notification=True{% endif %}
        )
        {% elif stickerUrl %}
        sticker_url = "{{ stickerUrl|e }}"
        from aiogram.types import BufferedInputFile as _StickerFile
        async with aiohttp.ClientSession() as session:
            async with session.get(sticker_url) as resp:
                sticker_data = await resp.read()
                await bot.send_sticker(
                    chat_id=_chat_id,
                    sticker=_StickerFile(sticker_data, filename="sticker.webp"){% if disableNotification %},
                    disable_notification=True{% endif %}
                )
        {% elif stickerSetName %}
        await bot.send_sticker(
            chat_id=_chat_id,
            sticker="{{ stickerSetName|e }}"{% if disableNotification %},
            disable_notification=True{% endif %}
        )
        {% else %}
        logging.warning(f"Стикер не настроен: узел {{ nodeId }}")
        {% endif %}
        await save_message_to_api(
            user_id=str(user_id),
            message_type="bot",
            message_text="[Стикер]",
            node_id="{{ nodeId }}"
        )
        {% if autoTransitionTo %}
        await handle_callback_{{ autoTransitionTo|safe_name }}(callback_query, state=None)
        {% endif %}
    except Exception as e:
        logging.error(f"Ошибка отправки стикера: {e}")
        {% if autoTransitionTo %}
        await handle_callback_{{ autoTransitionTo|safe_name }}(callback_query, state=None)
        {% endif %}
