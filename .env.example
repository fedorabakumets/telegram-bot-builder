# @fileoverview Пример переменных запуска панели и исполнителя ботов.
# В окружении остаются только параметры запуска процесса.
# Остальное настраивается в панели /admin: хранилища, бэкапы, воркеры,
# исполнители, сборки и площадка. Старые имена переменных по-прежнему
# работают как запасной вариант, пока значение не сохранено в админке.
# В этом примере они не перечислены.

# Адрес PostgreSQL панели
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_bot_builder

# Общий Redis API, исполнителя и брокера. В production используйте постоянный Redis с аутентификацией.
# У брокера это реестр единственного владельца сессий: другой Redis или номер БД создаст отдельный реестр.
REDIS_URL=redis://127.0.0.1:6379

# Секрет подписи сессий. В production обязателен: openssl rand -hex 32
SESSION_SECRET=change-this-secret-in-production

# Ключ входа в /admin. В production обязателен: openssl rand -hex 32
ADMIN_API_KEY=change-this-admin-key-in-production

# Порт HTTP
PORT=5000

# Адрес прослушивания
HOST=0.0.0.0

# development или production
NODE_ENV=development

# Порты локальных сервисов: npm run dev:services; встроенный брокер не требует четвёртого процесса верхнего уровня.
FRONTEND_PORT=5000
BACKEND_PORT=5001
# API и исполнитель должны использовать одинаковое имя; локальная команда согласует его автоматически.
WORKER_RUNNER_ID=default
RUNNER_ID=default
# В production на API: APP_MODE=backend, BOT_RUNTIME_MODE=api, WORKER_RUNTIME=remote.
# В production на исполнителе обязательно RUNNER_REQUIRE_FENCE=true; секреты Telegram ему не передаются.

# Приём обновлений: direct — обычный, ondemand — в общем процессе, process — временный процесс.
BOT_POLLING_MODE=direct
# Необязательный список ID записей токенов для ondemand/process; пусто — все.
BOT_ON_DEMAND_TOKEN_IDS=
# Простой обработчика до выгрузки; значение по умолчанию — 30 секунд.
BOT_ON_DEMAND_IDLE_SECONDS=30
# Предел отдельных процессов isolated и прежнего Python-приёмника: 0 без ограничений по умолчанию.
# Node/shared не ограничивает число загруженных сценариев этим значением.
BOT_ON_DEMAND_MAX_ACTIVE=0

# Снимки памяти Node, процессов Python, очередей и cgroup в журнале исполнителя.
# 0 — выключено; 30000 — каждые 30 секунд; минимальный интервал 5000 мс.
RUNNER_MEMORY_INTERVAL_MS=0
# Допуск нового Python-сценария: оценка стартового пика в МиБ (не ограничение RSS бота).
RUNNER_MEMORY_START_MB=64
# Свободный запас контейнера: максимум этого значения в МиБ и 15% конечного лимита cgroup.
RUNNER_MEMORY_HEADROOM_MB=64
# Приём обновлений для process: python — прежний общий приёмник; node — без Python в простое.
RUNNER_PROCESS_POLLING=python
# Обработчик при node: isolated — отдельный Python бота; shared — общий Python группы.
# Shared запускается при первом обновлении и работает, пока есть активные сценарии.
# После выгрузки всех сценариев Python завершается; следующее обращение запускает его заново.
# Node/shared загружает сценарии без фиксированного лимита; вместимость зависит от CPU и памяти.
# Сообщения одного бота остаются последовательными; отдельный лимит сообщений не задаётся.
# Node продолжает polling; холодный запуск не гарантирует мгновенного ответа.
RUNNER_PROCESS_HANDLER=shared
# Один выборочный профиль V8 после старта runner, автоматически заканчивается через 60 секунд.
RUNNER_HEAP_PROFILE=false
RUNNER_HEAP_PROFILE_SECONDS=60
RUNNER_HEAP_PROFILE_INTERVAL_BYTES=32768
RUNNER_HEAP_PROFILE_DIR=output/runner-memory-profiles
# Лимиты сжатой и распакованной сборки; проверяются до публикации файла в кеше.
RUNNER_BUILD_MAX_COMPRESSED_BYTES=268435456
RUNNER_BUILD_MAX_UNCOMPRESSED_BYTES=268435456
# Профиль выделений Python по файлам и строкам: включать временно, требует перезапуска worker.
WORKER_MEMORY_PROFILE=false
WORKER_MEMORY_PROFILE_SECONDS=60

# Ключ шифрования реквизитов S3 и сессий Telegram в БД API, минимум 16 символов.
# Создайте независимое значение: openssl rand -hex 32; сохраняйте ключ при обновлении приложения.
STORAGE_ENCRYPTION_KEY=change-this-storage-key-in-production

# Общий Telegram-клиент включается на API после миграций, подготовки реестра и готовности брокера.
# Первое развёртывание оставляет флаги выключенными; проверка готовности не открывает Telegram-сессии.
PROJECT_TELEGRAM_ACCOUNTS_ENABLED=0
# Перенос требует подтверждаемой остановки старого воркера.
PROJECT_TELEGRAM_ACCOUNT_CUTOVER_ENABLED=0
# external — отдельный сервис брокера; embedded — один общий брокер как дочерний процесс runtime.
# По умолчанию отдельный сервис. При embedded не запускайте второй отдельный broker service.
# Режим влияет только на размещение: одна сессия по-прежнему имеет одного владельца на весь сервис.
TELETHON_BROKER_MODE=external
# Только API: внутренний адрес самого API, доступный исполнителю. В split-dev это порт 5001.
# В Railway замените на http://<приватный-домен-backend>:5000, не адрес frontend или loopback.
PROJECT_TELEGRAM_API_BASE=http://127.0.0.1:5001
# Только API: независимый случайный секрет минимум 32 байта; runtime получает лишь подписанный ключ бота.
PROJECT_TELEGRAM_RUNNER_SECRET=
# Только API: адрес единственного брокера. В Railway external — домен broker, embedded — домен runtime.
# Для обоих вариантов используйте http://<приватный-домен-владельца>:8765.
TELETHON_BROKER_URL=http://127.0.0.1:8765
# Одинаковый секрет API и владельца брокера минимум 32 байта; обязательно отличается от секрета раннера.
# При embedded его получает процесс runtime для запуска брокера, но не процессы пользовательских ботов.
TELETHON_BROKER_SECRET=
# Только брокер: по умолчанию доступен лишь на loopback; private-сеть включается явно.
TELETHON_BROKER_ALLOW_PRIVATE_NETWORK=0
TELETHON_BROKER_HOST=127.0.0.1
TELETHON_BROKER_PORT=8765
# В Railway: ALLOW_PRIVATE_NETWORK=1, HOST=::, PORT=8765, без публичного домена и TCP-прокси.
# Постоянный том брокера хранит файл блокировки и журнал запрещённых аккаунтов .blocked.
# Локальный dev-launcher подставляет .local/telethon-broker.lock; в Railway путь задаёт Dockerfile.
TELETHON_BROKER_LOCK_FILE=
# Необязательный путь к Python-скрипту для embedded; по умолчанию рядом с RUNNER_WORKER_SCRIPT.
TELETHON_BROKER_SCRIPT=
# Все экземпляры используют один REDIS_URL и единственный реестр tbb:telethon-broker:singleton:v1.
# Перед первым запуском оператор явно инициализирует его значением unowned после проверки отсутствия владельца.
# После аварии нет автоматического захвата: сначала подтвердите остановку прежнего процесса и соединений.
# Не удаляйте ключ, не меняйте Redis и не выполняйте FLUSHDB, пока любой брокер может работать.

# Доверенный Telegram Agent: отдельный секрет минимум 32 случайных байта в обоих сервисах.
AGENT_AUTO_AUTH_ENABLED=false
AGENT_AUTO_AUTH_ID=bot-builder-agent
AGENT_AUTO_AUTH_SECRET=
# Пустое значение разрешает всех; для первого запуска перечислите тестовые Telegram ID.
AGENT_AUTO_AUTH_ALLOWED_IDS=
