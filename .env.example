# @fileoverview Пример переменных запуска панели и исполнителя ботов.
# В окружении остаются только параметры запуска процесса.
# Остальное настраивается в панели /admin: хранилища, бэкапы, воркеры,
# исполнители, сборки и площадка. Старые имена переменных по-прежнему
# работают как запасной вариант, пока значение не сохранено в админке.
# В этом примере они не перечислены.

# Адрес PostgreSQL панели
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_bot_builder

# Секрет подписи сессий. В production обязателен: openssl rand -hex 32
SESSION_SECRET=change-this-secret-in-production

# Ключ входа в /admin. В production обязателен: openssl rand -hex 32
ADMIN_API_KEY=change-this-admin-key-in-production

# Порт HTTP
PORT=5000

# Адрес прослушивания
HOST=0.0.0.0

# development или production
NODE_ENV=development

# Приём обновлений: direct — обычный, ondemand — в общем процессе, process — временный процесс.
BOT_POLLING_MODE=direct
# Необязательный список ID записей токенов для ondemand/process; пусто — все.
BOT_ON_DEMAND_TOKEN_IDS=
# Простой обработчика до выгрузки; значение по умолчанию — 30 секунд.
BOT_ON_DEMAND_IDLE_SECONDS=30
# Предел отдельных процессов isolated и прежнего Python-приёмника: 0 без ограничений по умолчанию.
# Node/shared не ограничивает число загруженных сценариев этим значением.
BOT_ON_DEMAND_MAX_ACTIVE=0

# Снимки памяти Node, процессов Python, очередей и cgroup в журнале исполнителя.
# 0 — выключено; 30000 — каждые 30 секунд; минимальный интервал 5000 мс.
RUNNER_MEMORY_INTERVAL_MS=0
# Приём обновлений для process: python — прежний общий приёмник; node — без Python в простое.
RUNNER_PROCESS_POLLING=python
# Обработчик при node: isolated — отдельный Python бота; shared — общий Python группы.
# Shared запускается при первом обновлении и работает, пока есть активные сценарии.
# После выгрузки всех сценариев Python завершается; следующее обращение запускает его заново.
# Node/shared загружает сценарии без фиксированного лимита; вместимость зависит от CPU и памяти.
# Сообщения одного бота остаются последовательными; отдельный лимит сообщений не задаётся.
# Node продолжает polling; холодный запуск не гарантирует мгновенного ответа.
RUNNER_PROCESS_HANDLER=shared
# Один выборочный профиль V8 после старта runner, автоматически заканчивается через 60 секунд.
RUNNER_HEAP_PROFILE=false
RUNNER_HEAP_PROFILE_SECONDS=60
RUNNER_HEAP_PROFILE_INTERVAL_BYTES=32768
RUNNER_HEAP_PROFILE_DIR=output/runner-memory-profiles
# Лимиты сжатой и распакованной сборки; проверяются до публикации файла в кеше.
RUNNER_BUILD_MAX_COMPRESSED_BYTES=268435456
RUNNER_BUILD_MAX_UNCOMPRESSED_BYTES=268435456
# Профиль выделений Python по файлам и строкам: включать временно, требует перезапуска worker.
WORKER_MEMORY_PROFILE=false
WORKER_MEMORY_PROFILE_SECONDS=60

# Ключ шифрования кредов S3, минимум 16 символов. openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=change-this-storage-key-in-production

# Доверенный Telegram Agent: отдельный секрет минимум 32 случайных байта в обоих сервисах.
AGENT_AUTO_AUTH_ENABLED=false
AGENT_AUTO_AUTH_ID=bot-builder-agent
AGENT_AUTO_AUTH_SECRET=
# Пустое значение разрешает всех; для первого запуска перечислите тестовые Telegram ID.
AGENT_AUTO_AUTH_ALLOWED_IDS=
