

# Актуальные переменные окружения настраиваются только администратором сервера.

# ─── База данных PostgreSQL ───────────────────────────────────────────────────

# Полный URL подключения
# Для локальной разработки:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_bot_builder
# Для Railway (подставляется автоматически):
# DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Отдельные параметры подключения (используются docker-compose и пулом соединений)
PGHOST=localhost
PGPORT=5432
PGDATABASE=telegram_bot_builder
PGUSER=postgres
PGPASSWORD=postgres

# Отключить SSL для локального PostgreSQL (без SSL-сертификата)
# В продакшене с внешним PostgreSQL — уберите эту строку или установите значение require
PGSSLMODE=disable

# Учётные данные PostgreSQL контейнера (только для docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telegram_bot_builder

# ─── Сервер приложения ────────────────────────────────────────────────────────

# Порт сервера
PORT=5000

# Хост привязки сервера
# Локально: 0.0.0.0 (все интерфейсы)
# Продакшен за reverse proxy: 127.0.0.1 (только локальный)
HOST=0.0.0.0

# Режим работы
NODE_ENV=development

# Режим входа (по умолчанию — dev-login по Telegram ID, без виджета)
# Настраивается в /admin/settings → «Режим входа на сайте» (auth_login_mode в app_settings).
# SKIP_AUTH=false  — fallback до первой настройки в admin: Telegram Login Widget
# SKIP_AUTH=true   — fallback: dev-login (то же, что без переменной)

# Секрет для подписи сессий — ОБЯЗАТЕЛЕН в production (иначе приложение не стартует).
# Сгенерируйте надёжное случайное значение, например: openssl rand -hex 32
SESSION_SECRET=change-this-secret-in-production

# Ключ входа в /admin (OpenAPI docs и ops-панель).
# Production: ОБЯЗАТЕЛЕН — без него /admin и /admin/docs недоступны.
# Development: можно не задавать — будет dev-fallback dev-only-insecure-admin-key (с предупреждением в лог).
# Сгенерируйте: openssl rand -hex 32
ADMIN_API_KEY=change-this-admin-key-in-production
#
# Админка и документация API:
#   /admin/login          — форма входа по ключу
#   /admin                — hub после входа
#   /admin/docs           — Swagger / Scalar / Redoc / RapiDoc (production, после входа)
#   /admin/openapi.json   — OpenAPI spec (production, после входа)
# Локальная разработка (NODE_ENV=development): публично также /docs, /docs-json и /docs/*

# ─── Redis ────────────────────────────────────────────────────────────────────

# Redis URL для кэша переменных и FSM хранилища ботов
# Для локальной разработки:
REDIS_URL=redis://localhost:6379
# Для Railway (подставляется автоматически после добавления Redis сервиса):
# REDIS_URL="${{Redis.REDIS_URL}}"

# ─── Telegram ─────────────────────────────────────────────────────────────────

# Прокси для Telegram API (если заблокирован)
# LogVPN использует HTTP прокси на http://127.0.0.1:10809
# Оставьте пустым, если прокси не нужен
TELEGRAM_PROXY_URL=http://127.0.0.1:10809

# Telegram Login (настраивается через /admin/settings при первом запуске)
# Эти переменные хранятся в PostgreSQL таблице app_settings.
# При первом запуске можно задать их здесь — они автоматически перенесутся в БД.
# После переноса эти строки можно удалить.
# TELEGRAM_CLIENT_ID=         # числовой Client ID из BotFather → Bot Settings → Web Login
# TELEGRAM_CLIENT_SECRET=     # Client Secret из BotFather → Bot Settings → Web Login
# VITE_TELEGRAM_CLIENT_ID=    # то же значение что и TELEGRAM_CLIENT_ID
# VITE_TELEGRAM_BOT_USERNAME= # имя бота без @ (например: blogspotbotbotbot)
# TELEGRAM_BOT_TOKEN=         # токен бота для Mini App авторизации (опционально)

# ─── Прочее ───────────────────────────────────────────────────────────────────

# Публичный URL API сервера (используется ботами для HTTP-запросов)
# Локально: http://localhost:5000
# На Railway: задаётся автоматически через RAILWAY_PUBLIC_DOMAIN, можно переопределить
API_BASE_URL=http://localhost:5000

# Персональный токен агента (PAT) для MCP-процесса — генерируется во вкладке «Агент».
# MCP_AGENT_TOKEN=mcp_...

# PAT со scope bot_manager для шаблона Bot Manager (Bearer на /api/bot/*).
# Создать: POST /api/agent-tokens { "label":"bot-manager", "scopes":"read,write,bot_manager" }
# В env бота: STUDIO_BOT_MANAGER_TOKEN=${{STUDIO_BOT_MANAGER_TOKEN}}
# STUDIO_BOT_MANAGER_TOKEN=mcp_...

# Кто может выдавать scope bot_manager в production (telegram user id через запятую).
# В development разрешено всем залогиненным.
# BOT_MANAGER_ADMIN_IDS=123456789

# Remote Streamable HTTP MCP на /mcp (по умолчанию включён; false/0/off — выключить)
# MCP_HTTP_ENABLED=true

# ─── Worker Pool ──────────────────────────────────────────────────────────────

# Путь к Python интерпретатору (если не в PATH)
# По умолчанию: "python" на Windows, "python3" на Linux/Mac
# PYTHON_PATH=C:\Users\1\AppData\Local\Programs\Python\Python313\python.exe

# Режим запуска ботов: 1 проект = 1 Python процесс = N ботов внутри
# Снижает потребление RAM в ~10 раз при большом количестве ботов
# true/не задано — все боты проекта работают в одном asyncio event loop
# false — каждый бот запускается как отдельный процесс (legacy)
USE_WORKER_POOL=true

# Группировка ботов по воркерам (только при USE_WORKER_POOL=true)
# project/не задано — 1 проект = 1 воркер (по умолчанию)
# owner  — 1 владелец = 1 воркер: все проекты пользователя в одном процессе,
#          RSS воркера = точная память пользователя, пользователи изолированы друг от друга
# shared — 1 воркер на все проекты: минимум RAM (aiogram и библиотеки грузятся один раз),
#          память проекта в /api/workers/stats — оценка по числу ботов
# WORKER_GROUPING=project

# Компилировать bot.py в байткод отдельным коротким процессом перед запуском в воркере
# Память на разбор большого файла (~70 МБ на 28 тыс. строк) не остаётся в воркере
# BOT_PRECOMPILE=true

# Кэш байткода ботов (.botcode рядом с bot.py); false — компилировать при каждом запуске
# BOT_CODE_CACHE=true

# Ленивая сборка моделей pydantic для aiogram в воркере (~100 МБ меньше на процесс)
# false — обычный импорт aiogram (если после обновления pydantic/aiogram что-то сломалось)
# AIOGRAM_LAZY_MODELS=true

# Подробный лог stdout воркера (JSON-сообщения) в консоль сервера
# WORKER_POOL_VERBOSE=false

# Где запускаются воркеры (подробно: docs/deployment/WORKER_DOCKER.md)
# process/не задано — дочерний процесс сервера (по умолчанию)
# docker — каждый воркер в своём контейнере; вместе с WORKER_GROUPING=owner — контейнер на человека.
#          В контейнер не попадают переменные сервера, видны только папки своих ботов
#          (только чтение) и uploads своих проектов. Нужен docker CLI и доступ к Docker.
# remote — воркеры запускает исполнитель `npm run runner` (можно на другой машине),
#          связь через Redis Streams; нужен REDIS_URL. Подробно: docs/deployment/BOT_RUNNER.md
# WORKER_RUNTIME=process
# ID исполнителя для режима remote (у исполнителя — RUNNER_ID с тем же значением)
# WORKER_RUNNER_ID=default
# Откуда исполнитель берёт код бота в режиме remote:
# build — скачивает сборку из S3 по временной ссылке (по умолчанию;
#         нужны BOT_ARTIFACT_SOURCE=storage и S3-хранилище в BOT_BUILDS_STORAGE_ID)
# path  — открывает .py по пути панели (только общий диск или та же машина)
# WORKER_RUNNER_CODE=build

# Образ контейнера воркера: Python 3.12 и зависимости из requirements.txt
# WORKER_DOCKER_IMAGE=ghcr.io/fedorabakumets/telegram-bot-builder:latest
# Python внутри образа
# WORKER_DOCKER_PYTHON=python3
# Сеть контейнера: host (по умолчанию) или сеть docker compose, где доступны db и redis
# WORKER_DOCKER_NETWORK=host
# Лимиты на один контейнер (на человека в режиме owner); пусто — без лимита
# WORKER_MEMORY_LIMIT=256m
# WORKER_CPUS=0.5
# Пользователь в контейнере uid:gid; по умолчанию — пользователь сервера
# WORKER_DOCKER_USER=1000:1000
# Если сервер сам работает в контейнере: путь к корню приложения на хосте (для -v)
# WORKER_DOCKER_HOST_ROOT=/opt/telegram-bot-builder
# Переменные сервера, которые разрешено передать ботам: попадают в контейнер,
# и только они раскрываются в ссылках ${{VAR}} переменных бота
# WORKER_ENV_PASSTHROUGH=TZ

# ─── Исполнитель ботов (npm run runner, для WORKER_RUNTIME=remote у панели) ──
# Исполнителю нужны только эти переменные; БД и секреты панели ему не нужны.
# REDIS_URL — тот же Redis, что у панели
# ID, под которым исполнитель принимает команды панели
# RUNNER_ID=default
# Python для worker.py (по умолчанию PYTHON_PATH или python3)
# RUNNER_PYTHON=python3
# Путь к worker.py (по умолчанию server/python/worker.py рядом с исполнителем)
# RUNNER_WORKER_SCRIPT=
# Кеш скачанных из S3 сборок (по умолчанию ~/.tbb-runner/builds)
# RUNNER_CACHE_DIR=
# Сколько сборок хранить в кеше; запущенные не удаляются
# RUNNER_BUILDS_KEEP=20

# ─── Боты в сервисах Railway ──────────────────────────────────────────────────
# Проекты, чьи боты работают в отдельных сервисах Railway (панель создаёт и
# останавливает их сама). Подробно: docs/deployment/BOT_RAILWAY.md
# WORKER_RAILWAY_PROJECTS=1,5
# Токен проекта Railway или RAILWAY_API_TOKEN — токен workspace/аккаунта
# RAILWAY_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_RUNNER_IMAGE=ghcr.io/fedorabakumets/telegram-bot-builder-runner:latest
# Регион сервисов ботов, например europe-west4-drams3a (Амстердам); пусто — по умолчанию Railway
# RAILWAY_REGION=
# Redis для связи с исполнителями (по умолчанию REDIS_URL панели)
# WORKER_RUNNER_REDIS_URL=
# Адреса БД и Redis для ботов на Railway (вместо адресов панели)
# RAILWAY_BOT_DATABASE_URL=
# RAILWAY_BOT_REDIS_URL=

# ─── Сборки ботов ─────────────────────────────────────────────────────────────
# Где хранится сгенерированный код ботов:
# disk    — только папка bots/ (по умолчанию, как раньше);
# storage — дополнительно сборка в хранилище + запись в bot_builds. При авто-восстановлении
#           бот поднимается из сборки, даже если папки bots/ нет. Секреты в сборку не попадают.
# BOT_ARTIFACT_SOURCE=disk
# ID хранилища из storage_configs (например S3). Пусто — приватная папка BOT_BUILDS_DIR.
# Хранилище не должно быть публичным: в сборке весь код бота.
# BOT_BUILDS_STORAGE_ID=
# Приватная папка сборок (не раздаётся по HTTP, в отличие от uploads/)
# BOT_BUILDS_DIR=.bot-builds
# Сколько последних сборок хранить на токен
# BOT_BUILDS_KEEP=3

# ─── Бэкапы базы ──────────────────────────────────────────────────────────────
# npm run db:backup / db:backups / db:restore. Подробно: docs/deployment/DB_BACKUPS.md
# ID хранилища из storage_configs (S3). Пусто — приватная папка DB_BACKUPS_DIR.
# В дампе токены ботов и сессии userbot: хранилище не должно быть публичным.
# DB_BACKUPS_STORAGE_ID=
# DB_BACKUPS_DIR=.db-backups
# Сколько последних бэкапов хранить на метку
# DB_BACKUPS_KEEP=7
# Автоматический бэкап базы панели раз в N часов (0 — выключен)
# DB_BACKUP_INTERVAL_HOURS=0
# Метка бэкапов базы панели
# DB_BACKUP_LABEL=panel
# Другие базы в том же расписании: метка=адрес через пробел или ; (внешний адрес, например TCP Proxy Railway)
# DB_BACKUP_TARGETS=railway-tbb-bots=postgresql://postgres:...@host.proxy.rlwy.net:12345/railway
# Папка с pg_dump/pg_restore/psql, если их не нашли автоматически
# PG_BIN_DIR=

# Как переменные бота (токен, ADMIN_IDS, userbot, свои переменные) попадают к боту:
# file   — файл .env в папке бота (по умолчанию, как раньше);
# inline — собираются из БД при каждом запуске и передаются воркеру в команде start_bot.
#          Файла .env в папке бота нет (старый удаляется), секреты не лежат на диске.
#          Режим работает только с воркером (USE_WORKER_POOL не false) или обычным процессом.
# BOT_ENV_SOURCE=file

# Потолок RAM контейнера app (docker-compose mem_limit).
# При превышении ядро убивает воркер, а не весь сервер.
# Пусто / 0 / не задано → без лимита. Пример для VPS ~3 ГБ: 1280m
# APP_MEM_LIMIT=1280m

# ─── Хранилище файлов ─────────────────────────────────────────────────────────

# Лимит дискового хранилища в гигабайтах (учитываются только локальные файлы,
# storage_backend = 'local'; файлы в S3 в серверную квоту не входят).
# Допускается дробное число (например 1.5). Пусто / 0 / не задано → безлимитно.
# STORAGE_LIMIT_GB=

# Тип дефолтного хранилища для первичного сидирования реестра storage_configs:
#   local — локальная папка uploads/ (по умолчанию)
#   s3    — S3-совместимое хранилище (требует переменные S3_* ниже)
# ENV используется только для бутстрапа дефолтов при пустом реестре —
# дальнейшие хранилища добавляются через API/UI.
STORAGE_BACKEND=local

# ─── S3-хранилище (опционально, для STORAGE_BACKEND=s3) ────────────────────────
# Минимально необходим S3_BUCKET — без него S3-конфиг не создаётся.

# Endpoint S3. Для MinIO/совместимых — адрес сервера; пусто = AWS S3.
# Пример для локального MinIO:
# S3_ENDPOINT_URL=http://localhost:9000

# Регион (по умолчанию us-east-1, если не задан)
# S3_REGION=us-east-1

# Имя бакета
# S3_BUCKET=botcraft-files

# Ключ доступа S3 (плейсхолдер — подставьте реальный на сервере)
# S3_ACCESS_KEY_ID=your-access-key-id

# Секретный ключ S3 (плейсхолдер — подставьте реальный на сервере)
# S3_SECRET_ACCESS_KEY=your-secret-access-key

# Path-style адресация бакета (true — нужно для MinIO; false — для AWS S3)
# S3_FORCE_PATH_STYLE=true

# Базовый публичный URL для отдачи объектов (опционально).
# Если не задан — приватные объекты отдаются через серверный прокси/presigned URL.
# S3_PUBLIC_URL_BASE=

# Ключ шифрования секретов S3 (storage_configs.secretsEnc).
# Без него креды S3 не сохраняются в БД и задаются позже через UI.
# Сгенерируйте надёжное случайное значение, например: openssl rand -hex 32
# STORAGE_ENCRYPTION_KEY=change-this-storage-encryption-key
